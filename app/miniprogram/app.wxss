page{background:#0a0a0a;color:#f5f5f5;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}
view,text,input,textarea,button{box-sizing:border-box}
button{font-size:27rpx;line-height:1.5;border-radius:16rpx;font-weight:600;margin:0;padding:22rpx 28rpx;color:#f5f5f5;background:#222}
button::after{border:0}button[disabled]{opacity:.45}
input,textarea{width:100%;background:#141414;padding:22rpx;border:1rpx solid #363636;border-radius:14rpx;color:#f5f5f5;font-size:28rpx}
input{height:88rpx}textarea{height:170rpx;line-height:1.5}
.page{padding:30rpx 30rpx 64rpx}
.demo{background:#1c140e;color:#e5b991;text-align:center;font-size:21rpx;padding:10rpx 20rpx;border-bottom:1rpx solid #3d2818}
.masthead{display:flex;align-items:center;justify-content:space-between;margin-bottom:30rpx}
.wordmark{font-style:italic;font-size:54rpx;font-weight:900;line-height:1;letter-spacing:-5rpx;color:#ff6b00}
.wordmark text{font-size:21rpx;letter-spacing:2rpx;font-style:normal;margin-left:18rpx;font-weight:600;color:#f5f5f5}
.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#ff8a3d;text-transform:uppercase;margin-bottom:12rpx}
.title{font-size:42rpx;line-height:1.35;letter-spacing:-1rpx;font-weight:700}
.subtitle{color:#a8a8a8;font-size:25rpx;margin-top:14rpx;line-height:1.7}
.section-head{display:flex;align-items:center;justify-content:space-between;margin:38rpx 0 22rpx}
.section-title{font-size:30rpx;font-weight:700}.section-index{font-size:20rpx;letter-spacing:2rpx;color:#a0a0a0}
.card{background:#1a1a1a;border:1rpx solid #2a2a2a;border-radius:22rpx;padding:28rpx;margin-bottom:22rpx;overflow:hidden}
.card-title{font-size:29rpx;font-weight:650;line-height:1.5}
.muted{color:#a8a8a8}.small{font-size:23rpx}.tiny{font-size:21rpx}.paragraph{line-height:1.9;white-space:pre-wrap}
.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrap{flex-wrap:wrap}.grow{flex:1;min-width:0}
.mt{margin-top:24rpx}.mb{margin-bottom:24rpx}.gap{height:24rpx}.divider{height:1rpx;background:#303030;margin:24rpx 0}
.tag{display:inline-block;padding:6rpx 14rpx;background:#252525;color:#bcbcbc;border:1rpx solid #414141;border-radius:50rpx;font-size:22rpx}
.tag-dark{background:#2b1c10;color:#ff9d59;border-color:#75401b}.tag-warm{color:#f6c66c;background:#302714;border-color:#604b20}
.pill{padding:13rpx 24rpx;background:#1a1a1a;border:1rpx solid #303030;border-radius:50rpx;font-size:24rpx;font-weight:400;white-space:nowrap;color:#b8b8b8}
.pill.active{background:#ff6b00;color:#0a0a0a;border-color:#ff6b00;font-weight:650}
.filter-row{display:flex;gap:12rpx;margin:28rpx 0;overflow-x:auto;white-space:nowrap}.filter-row::-webkit-scrollbar{display:none;width:0;height:0}
.primary{background:#ff6b00;color:#0a0a0a}.secondary{background:#1a1a1a;border:1rpx solid #3b3b3b;color:#ededed}
.danger{background:#301a16;color:#ffad95;border:1rpx solid #65382d}.full{width:100%}.mini{padding:13rpx 19rpx;font-size:23rpx;display:inline-block;font-weight:550}
.actions{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:24rpx}
.text-button{background:transparent;color:#ff923f;font-size:24rpx;padding:6rpx 0;font-weight:500}
.notice{background:#241a11;border-left:3rpx solid #b95b20;border-radius:8rpx;padding:22rpx 24rpx;color:#dfb390;font-size:24rpx;line-height:1.8;margin:24rpx 0}
.error{background:#2d1915;border-left-color:#d67150;color:#ffbaa3}
.empty{text-align:center;padding:65rpx 28rpx;color:#a0a0a0;font-size:26rpx;line-height:1.9}.loading{text-align:center;padding:36rpx;color:#b6b6b6;font-size:25rpx}
.stats{display:flex;background:#1a1a1a;border:1rpx solid #2a2a2a;padding:30rpx 16rpx;border-radius:22rpx;margin:28rpx 0}
.stat{flex:1;text-align:center}.stat+.stat{border-left:1rpx solid #303030}.stat-number{font-size:43rpx;line-height:1.2;font-weight:700;letter-spacing:-1rpx;font-variant-numeric:tabular-nums}.stat-label{font-size:22rpx;color:#a8a8a8;margin-top:10rpx}
.field{margin:24rpx 0}.field-label{display:block;font-size:25rpx;color:#b8b8b8;margin-bottom:12rpx}.field input,.field textarea{background:#141414}
.check-line{display:flex;align-items:flex-start;gap:12rpx;font-size:25rpx;line-height:1.8;margin:26rpx 0}.check-line checkbox{transform:scale(.85);margin-left:-7rpx}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.picker{background:#141414;border:1rpx solid #3a3a3a;padding:23rpx;border-radius:14rpx;min-height:88rpx;color:#f2f2f2}
.footer-note{font-size:21rpx;line-height:1.9;color:#999;text-align:center;margin-top:44rpx}
.hero{position:relative;background:#1b1714;color:#fff;border-radius:22rpx;overflow:hidden;padding:34rpx;min-height:300rpx;margin:30rpx 0}
.hero-content{position:relative;z-index:1}.hero .eyebrow{color:#ff8a3d}.hero-title{font-size:48rpx;font-weight:750;line-height:1.25;letter-spacing:-1rpx;margin:24rpx 0 14rpx}.hero-bottom{color:#bcbcbc;font-size:23rpx;margin-top:30rpx}
.activity-art{height:140rpx;position:relative;overflow:hidden;background:linear-gradient(135deg,#402816,#1a1a1a);margin:-28rpx -28rpx 25rpx}.activity-art text{position:relative;font-size:22rpx;letter-spacing:5rpx;display:block;margin:28rpx;color:#ff9b54}
.avatar{width:100rpx;height:100rpx;border-radius:50%;background:#302014;display:flex;align-items:center;justify-content:center;font-size:44rpx;color:#ff8a3d}
.ledger-value{font-size:32rpx;color:#ff8a3d;font-weight:650;font-variant-numeric:tabular-nums}.point-sign{color:#ff8a3d}.negative{color:#ffab94}
.list-link{padding:26rpx 0;border-bottom:1rpx solid #303030;display:flex;align-items:center;justify-content:space-between;font-size:27rpx}.list-link:active{background:#242424}
.rank{width:56rpx;font-size:34rpx;color:#ff8a3d;font-weight:700}.rank-name{font-size:28rpx;font-weight:600}
.timeline{padding-left:24rpx;border-left:3rpx solid #6f3c1a;color:#a8a8a8;font-size:23rpx;line-height:2}.active-line{color:#ff9b54;font-weight:600}
.bottom-bar{position:sticky;bottom:0;background:#0a0a0a;padding:22rpx 0 10rpx;border-top:1rpx solid #303030;margin-top:30rpx}
.staff-strip{background:#2b1c10;color:#ffb57d;padding:18rpx 25rpx;font-size:23rpx;border:1rpx solid #5b371e;border-radius:14rpx;margin-top:20rpx}
.switch-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.privacy-text{font-size:24rpx;line-height:1.9;color:#b5b5b5}
.membership-card{background:#191512;color:#fff;border:1rpx solid #58351c;border-radius:24rpx;padding:32rpx}
.member-mark{font-size:49rpx;letter-spacing:-4rpx;color:#ff8a3d}.member-mark text{font-size:19rpx;letter-spacing:2rpx}.member-badge{font-size:23rpx;padding:7rpx 17rpx;border:1rpx solid #8a4a20;border-radius:50rpx;color:#ffaf76}
.member-name{font-size:42rpx;font-weight:650;line-height:1.4;margin-top:34rpx}.member-caption{font-size:22rpx;color:#aaa;margin-top:10rpx}.member-rule{border-top:1rpx solid #463124;padding-top:22rpx;margin-top:30rpx;font-size:24rpx;color:#c7b6a8;line-height:1.8}
.menu-card{padding:4rpx 26rpx}.menu-card .list-link:last-child{border-bottom:0}.contact-value{font-size:29rpx;font-weight:500;word-break:break-all}
.segmented{display:flex;gap:6rpx;padding:7rpx;background:#171717;border:1rpx solid #303030;border-radius:16rpx}.segment{flex:1;padding:17rpx 10rpx;background:transparent;color:#aaa;border-radius:10rpx;font-size:26rpx;font-weight:500}.segment.selected{background:#ff6b00;color:#0a0a0a;font-weight:650}
.member-avatar{height:80rpx;width:80rpx;flex-shrink:0;background:#302014;color:#ff9b54;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:750;font-size:29rpx;margin-right:10rpx}
.recommendation-card{padding:28rpx 24rpx}.recommendation-card .tag{font-size:20rpx;white-space:nowrap}
.next-trip{background:#1e1712;border:1rpx solid #5b351b;border-radius:22rpx;padding:28rpx}.next-trip-title{font-size:33rpx;font-weight:650;line-height:1.5;margin:20rpx 0 12rpx}.no-margin{margin:0}
.welcome-strip{background:#1a1a1a;border:1rpx solid #303030;border-radius:20rpx;padding:27rpx}.compact-hero{min-height:245rpx}.compact-hero .hero-bottom{margin-top:18rpx}.compact-hero .hero-title{font-size:42rpx;margin:18rpx 0}
.activity-card{padding-top:26rpx}.activity-date{font-size:27rpx;font-weight:500;color:#d0b09a}.activity-summary{border-bottom:1rpx solid #303030;padding:24rpx 0 30rpx;margin-bottom:30rpx}
.briefing-row{padding:22rpx 0;border-bottom:1rpx solid #303030}.briefing-row:first-child{padding-top:0}.briefing-row:last-child{border-bottom:0;padding-bottom:0}
.checklist-item{display:flex;gap:14rpx;align-items:flex-start;padding:24rpx 0;border-bottom:1rpx solid #303030;font-size:27rpx;line-height:1.7}.checklist-item:last-child{border-bottom:0}.checklist-item checkbox{transform:scale(.85);flex-shrink:0;margin-left:-5rpx}
.record-row{display:flex;gap:22rpx;padding:13rpx 0 28rpx;position:relative}.record-row:last-child{padding-bottom:0}.record-dot{height:14rpx;width:14rpx;border:3rpx solid #ff8a3d;border-radius:50%;margin-top:15rpx;flex-shrink:0}.record-row .grow{border-bottom:1rpx solid #303030;padding-bottom:24rpx}.record-row:last-child .grow{border-bottom:0;padding-bottom:0}
