sition:sticky;bottom:0;background:#f6f7f4;padding:22rpx 0 10rpx;border-top:1rpx solid #e1e4d8;margin-top:30rpx}.staff-strip{background:#1c3027;color:#ddeb91;padding:18rpx 25rpx;font-size:23rpx;border-radius:9rpx;margin-top:20rpx}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.privacy-text{font-size:24rpx;line-height:1.9;color:#6c7865}.point-sign{color:#31543e}.negative{color:#9a5b31}

.filter-row::-webkit-scrollbar{display:none;width:0;height:0}.stat+.stat{border-left:1rpx solid #edf0e7}.field input,.field textarea{background:#fff}.list-link:active{background:#f6f8f2}.card:active{border-color:#ccd6bf}
