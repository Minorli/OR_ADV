page{background:#f6f7f4;color:#23342a;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.6}view,text,input,textarea,button{box-sizing:border-box}button{font-size:27rpx;line-height:1.5;border-radius:8rpx;font-weight:500;margin:0;padding:22rpx 28rpx;color:#31543e;background:#e9eedc}button::after{border:0}button[disabled]{opacity:.42}input,textarea{width:100%;background:#fffefa;padding:22rpx;border:1rpx solid #dce2d2;border-radius:8rpx;color:#1c3027;font-size:28rpx}input{height:88rpx}textarea{height:170rpx;line-height:1.5}.page{padding:32rpx 34rpx 64rpx}.demo{background:#edf1e7;color:#6b7a57;text-align:center;font-size:21rpx;padding:11rpx 20rpx}.masthead{display:flex;align-items:center;justify-content:space-between;margin-bottom:34rpx}.wordmark{font-style:italic;font-size:56rpx;font-weight:900;line-height:1;letter-spacing:-6rpx}.wordmark text{font-size:24rpx;letter-spacing:2rpx;font-style:normal;margin-left:18rpx;font-weight:500}.eyebrow{font-size:20rpx;letter-spacing:4rpx;color:#6f8057;text-transform:uppercase;margin-bottom:12rpx}.title{font-size:44rpx;line-height:1.35;letter-spacing:-1rpx;font-weight:650}.subtitle{color:#869080;font-size:26rpx;margin-top:14rpx;line-height:1.7}.section-head{display:flex;align-items:center;justify-content:space-between;margin:40rpx 0 22rpx}.section-title{font-size:30rpx;font-weight:600}.section-index{font-size:20rpx;letter-spacing:3rpx;color:#81877b}.card{background:#fff;border:1rpx solid #e5e8e1;border-radius:12rpx;padding:28rpx;margin-bottom:22rpx;overflow:hidden;box-shadow:0 3rpx 12rpx rgba(32,51,42,.025)}.card-title{font-size:30rpx;font-weight:600;line-height:1.5}.muted{color:#869080}.small{font-size:23rpx}.tiny{font-size:21rpx}.paragraph{line-height:1.9;white-space:pre-wrap}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.wrap{flex-wrap:wrap}.grow{flex:1}.mt{margin-top:24rpx}.mb{margin-bottom:24rpx}.gap{height:24rpx}.divider{height:1rpx;background:#e1e4d8;margin:24rpx 0}.tag{display:inline-block;padding:6rpx 14rpx;background:#eef3e7;color:#547043;border-radius:6rpx;font-size:22rpx}.tag-dark{background:#31543e;color:#eff4df}.tag-warm{color:#9a5b31;background:#f3ead9}.pill{padding:13rpx 26rpx;background:transparent;border:1rpx solid #d8decd;border-radius:50rpx;font-size:24rpx;font-weight:400;white-space:nowrap}.pill.active{background:#31543e;color:#fffefa;border-color:#31543e}.filter-row{display:flex;gap:14rpx;margin:30rpx 0;overflow-x:auto;white-space:nowrap}.primary{background:#31543e;color:#fffefa}.secondary{background:#fff;border:1rpx solid #dce2d5;color:#31543e}.danger{background:#f3ead9;color:#9a5b31}.full{width:100%}.mini{padding:13rpx 19rpx;font-size:23rpx;display:inline-block;font-weight:500}.actions{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:24rpx}.text-button{background:transparent;color:#31543e;font-size:24rpx;text-decoration:underline;text-underline-offset:6rpx;padding:6rpx 0;font-weight:400}.notice{background:#f0f4e9;border-left:3rpx solid #9aac77;border-radius:4rpx;padding:22rpx 24rpx;color:#57694d;font-size:24rpx;line-height:1.8;margin:24rpx 0}.error{background:#f3ead9;border-left-color:#b46634;color:#8b542f}.empty{text-align:center;padding:65rpx 28rpx;color:#81877b;font-size:26rpx;line-height:1.9}.loading{text-align:center;padding:36rpx;color:#6f8057;font-size:25rpx}.stats{display:flex;background:#fff;border:1rpx solid #e5e8e1;padding:30rpx 16rpx;border-radius:12rpx;margin:28rpx 0}.stat{flex:1;text-align:center}.stat-number{font-size:44rpx;line-height:1.2;font-weight:650;letter-spacing:-1rpx}.stat-label{font-size:22rpx;color:#7a8b68;margin-top:10rpx}.field{margin:24rpx 0}.field-label{display:block;font-size:25rpx;color:#57694d;margin-bottom:12rpx}.check-line{display:flex;align-items:flex-start;gap:12rpx;font-size:25rpx;line-height:1.8;margin:26rpx 0}.check-line checkbox{transform:scale(.85);margin-left:-7rpx}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.picker{background:#fff