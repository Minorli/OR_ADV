.redemption-page{padding-bottom:60rpx}.redemption-heading{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.redemption-heading .eyebrow{font-size:18rpx;letter-spacing:3rpx}.redemption-heading .text-button{flex-shrink:0}
.redemption-wallet{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin:28rpx 0;padding:26rpx 28rpx;background:linear-gradient(135deg,#2c2116,#171512);border:1rpx solid #62421f;border-radius:20rpx}.redemption-balance{color:#ff963f;font-size:58rpx;line-height:1.2;font-weight:700;display:block}.redemption-unit{font-size:21rpx;color:#a99885;margin-top:8rpx;display:block}.redemption-wallet-right{display:flex;flex-direction:column;gap:10rpx;text-align:right;color:#c5b49f;font-size:23rpx}
.redemption-tabs{display:flex;padding:5rpx;background:#171717;border:1rpx solid #303030;border-radius:15rpx;margin:25rpx 0}.redemption-tab{flex:1;min-width:0;width:0;margin:0;padding:18rpx 7rpx;border:0;border-radius:11rpx;background:transparent;color:#a9a9a9;font-size:23rpx;font-weight:500;line-height:1.5}.redemption-tab.selected{background:#ff6b00;color:#111;font-weight:600}.redemption-tab::after{display:none;border:0}.redemption-management-tabs{display:flex;gap:10rpx;flex-wrap:wrap;margin:25rpx 0}.redemption-management-tabs .pill{font-size:22rpx;padding:13rpx 21rpx}
.redemption-note{font-size:22rpx;color:#a89c90;line-height:1.85;margin:22rpx 0}.redemption-policy{font-size:23rpx;color:#b8aa9b;line-height:1.85;padding:23rpx;background:#171717;border:1rpx solid #2b2823;border-radius:15rpx;margin:24rpx 0}
.redemption-item{padding:29rpx;border:1rpx solid #303030;background:#1a1a1a;border-radius:22rpx;margin:23rpx 0}.redemption-item-top{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.redemption-kind{font-size:19rpx;letter-spacing:1rpx;color:#dd9c60;border:1rpx solid #5c3d23;border-radius:7rpx;padding:5rpx 10rpx;background:#261d15}.redemption-stock{font-size:21rpx;color:#919191}.redemption-item-name{font-size:34rpx;line-height:1.5;font-weight:600;color:#ececec;margin-top:24rpx;word-break:break-all}.redemption-item-description{font-size:24rpx;color:#a2a2a2;line-height:1.85;margin-top:13rpx;white-space:pre-wrap}.redemption-item-bottom{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:27rpx;padding-top:24rpx;border-top:1rpx solid #303030}.redemption-cost{font-size:42rpx;color:#ff9747;font-weight:600;line-height:1.2;white-space:nowrap}.redemption-cost>text{font-size:22rpx;margin-left:9rpx;font-weight:400;color:#a99b8e}.redemption-item-bottom .secondary{font-size:23rpx;padding:18rpx 24rpx;border-radius:11rpx;font-weight:500}
.redemption-confirm{border-color:#654220;margin-top:30rpx}.redemption-delivery{padding:25rpx 0;margin-top:8rpx;border-bottom:1rpx solid #333}.redemption-confirm-facts{margin:22rpx 0}.redemption-confirm-facts>view{display:flex;align-items:center;justify-content:space-between;gap:20rpx;font-size:24rpx;padding:13rpx 0;color:#b6b6b6}.redemption-confirm-facts>view>text:last-child{color:#f2c295}.redemption-request{margin-top:24rpx}.redemption-request-cost{color:#ff9f50;font-size:28rpx;font-weight:600}.redemption-request-reason{border-left:3rpx solid #8c5428;padding:15rpx 18rpx;margin-top:23rpx;background:#221b14;color:#c8ae93;font-size:23rpx;line-height:1.75}.redemption-admin-item{margin-top:24rpx}.redemption-inventory{display:flex;gap:20rpx;flex-wrap:wrap;margin-top:20rpx;color:#aaa;font-size:22rpx}.redemption-item-open{text-align:right;color:#db955f;font-size:22rpx;margin-top:20rpx}.redemption-editor{border-color:#5b3e25;margin-top:28rpx}.redemption-editor .form-grid{gap:16rpx}.redemption-page .field-label{font-size:24rpx}.redemption-page .primary,.redemption-page .secondary{border-radius:13rpx}.redemption-page .picker{font-size:24rpx;line-height:1.7}.redemption-page .field textarea{min-height:160rpx}.redemption-page .empty{font-size:24rpx;padding:45rpx 23rpx}.redemption-page .tag{font-size:20rpx}.redemption-page .notice .mt{margin-top:16rpx}.redemption-policy-form{margin-top:25rpx}
