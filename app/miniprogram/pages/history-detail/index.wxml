<view wx:if="{{isMock}}" class="demo">内测演示 · 数据仅保存在本机</view>
<view class="page history-detail">
  <view wx:if="{{loading}}" class="loading">正在打开本场记录…</view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">刷新记录</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <block wx:if="{{detail}}">
    <view class="history-heading"><view class="eyebrow">OR / RIDE JOURNAL</view><view class="title">{{detail.activity.title}}</view><view class="history-meta">{{date}} · {{detail.activity.location}}</view><view class="history-line"></view><view class="history-caption">{{detail.activity.difficulty}} · 已完成结算</view></view>
    <view class="section-head"><text class="section-title">本场回顾</text><button wx:if="{{isOwner && !manage}}" class="text-button" bindtap="manage">编辑回顾 ›</button></view>
    <view class="card paragraph">{{detail.story.intro || detail.activity.description}}</view>
    <view wx:if="{{photos.length}}" class="section-head"><text class="section-title">本场影像</text><text class="section-index">{{photos.length}} 张</text></view>
    <view wx:if="{{photos.length}}" class="photo-grid"><view wx:for="{{photos}}" wx:key="url" class="photo-tile" data-url="{{item.url}}" bindtap="preview"><image src="{{item.url}}" mode="aspectFill" lazy-load data-url="{{item.url}}" binderror="photoFailed"/><view class="photo-label">{{item.label}}</view></view></view>
    <view wx:if="{{documentaryUrl}}" class="film-section"><view class="section-head"><text class="section-title">{{detail.story.documentary.title}}</text><text class="section-index">纪录片</text></view><video id="history-documentary" class="film" src="{{documentaryUrl}}" controls show-center-play-btn enable-progress-gesture bindplay="videoPlaying" bindpause="videoStopped" bindended="videoStopped" binderror="videoFailed"/></view>
    <view wx:if="{{videoError}}" class="notice">{{videoError}}</view>
    <view wx:if="{{detail.story.honors.length}}" class="honor-strip"><view class="eyebrow">同行留名</view><view wx:for="{{detail.story.honors}}" wx:key="label" class="honor"><text class="honor-name">{{item.nickname}}</text><text class="honor-label">{{item.label}}</text></view></view>
    <view class="section-head"><text class="section-title">同行评价</text><text class="section-index">真实参加 · 自愿公开</text></view>
    <view wx:for="{{reviews}}" wx:key="publicId" class="card review-card"><view class="row"><text class="card-title">{{item.nickname}}</text><text class="stars">{{item.starText}}</text></view><view class="paragraph review-copy">{{item.comment}}</view></view>
    <view wx:if="{{!reviews.length}}" class="review-empty">还没有已发布的同行评价。</view>
    <button wx:if="{{nextCursor}}" class="secondary full" disabled="{{busy}}" bindtap="moreReviews">继续查看评价</button>
    <view wx:if="{{!member}}" class="notice">完整参加本场活动的车友，登录后可以留下评价。<button class="text-button" bindtap="profile">前往我的 ›</button></view>
    <view wx:if="{{member && own.eligible && !manage}}" class="card review-form"><view class="card-title">留下一段同行感受</view><view wx:if="{{own.review}}" class="subtitle">{{own.review.status === 'pending' ? '待主理人核对' : own.review.status === 'approved' ? '已公开' : own.review.status === 'withdrawn' ? '已撤回' : '暂未发布'}}{{own.review.reason ? ' · ' + own.review.reason : ''}}</view><view class="star-choices"><button wx:for="{{starOptions}}" wx:key="*this" class="star-choice {{stars >= item ? 'chosen' : ''}}" data-stars="{{item}}" bindtap="chooseStars">★</button></view><textarea value="{{comment}}" data-field="comment" maxlength="800" placeholder="这场活动中，你记住了什么？" bindinput="field"/>
      <checkbox-group bindchange="consent"><label class="check-line"><checkbox value="publish" checked="{{publishConsent}}" color="#ff6b00"/><text>同意评价内容经核对后向所有访客公开。</text></label><label class="check-line"><checkbox value="nickname" checked="{{nicknameConsent}}" color="#ff6b00"/><text>同意本条评价展示当前昵称。</text></label><label class="check-line"><checkbox value="honor" checked="{{honorConsent}}" color="#ff6b00"/><text>另行同意主理人选用昵称与本场荣誉标签；可随评价一并撤回。</text></label></checkbox-group>
      <button class="primary full" disabled="{{busy}}" bindtap="saveReview">交给主理人核对</button><button wx:if="{{own.review && own.review.status !== 'withdrawn'}}" class="text-button withdraw" disabled="{{busy}}" bindtap="withdraw">撤回公开评价</button>
    </view>
  </block>
  <block wx:if="{{manage && isOwner && story}}">
    <view class="section-head"><text class="section-title">编辑本场内容</text><text class="section-index">主理人</text></view>
    <view class="card"><view class="field-label">活动回顾</view><textarea class="intro-input" value="{{intro}}" data-field="intro" maxlength="4000" bindinput="field" placeholder="写下这一次同行的真实记录"/><view class="field"><view class="field-label">本场图片 · {{photoAssetIds.length}} / 12</view><view class="edit-photo-grid"><view wx:for="{{photoAssetIds}}" wx:key="*this" class="edit-photo"><image wx:if="{{photoUrls[item]}}" src="{{photoUrls[item]}}" mode="aspectFill"/><text wx:else class="small muted">图片暂不可用</text><button class="remove-photo" data-id="{{item}}" bindtap="removePhoto">移除</button></view></view></view>
      <checkbox-group bindchange="rights"><label class="check-line"><checkbox value="photos" checked="{{photoRights}}" color="#ff6b00"/><text>确认选用图片已获得拍摄者与相关人物的公开展示许可。</text></label><label class="check-line"><checkbox value="film" checked="{{filmRights}}" color="#ff6b00"/><text>确认影片可公开播放，并已获得相关使用许可。</text></label></checkbox-group><button class="secondary full" disabled="{{busy}}" bindtap="uploadPhoto">选择本场图片</button>
      <view class="field"><view class="field-label">纪录片名称</view><input value="{{documentaryTitle}}" data-field="documentaryTitle" maxlength="80" bindinput="field" placeholder="没有影片可留空"/></view><view class="field"><view class="field-label">公开影片直连地址</view><input value="{{documentaryInput}}" data-field="documentaryInput" maxlength="1500" bindinput="field" placeholder="https://…/film.mp4"/><view class="small muted mt">使用可公开播放、无查询参数的HTTPS MP4链接。填写链接不会生成影片。</view></view>
      <view class="field"><view class="field-label">本场荣誉一</view><picker range="{{honorChoices}}" range-key="label" value="{{honor0Index}}" data-slot="0" bindchange="honor"><view class="picker">{{honorChoices[honor0Index].label}}</view></picker><input class="mt" value="{{honor0Label}}" data-field="honor0Label" maxlength="30" bindinput="field" placeholder="填写真实核定的本场荣誉"/></view><view class="field"><view class="field-label">本场荣誉二</view><picker range="{{honorChoices}}" range-key="label" value="{{honor1Index}}" data-slot="1" bindchange="honor"><view class="picker">{{honorChoices[honor1Index].label}}</view></picker><input class="mt" value="{{honor1Label}}" data-field="honor1Label" maxlength="30" bindinput="field" placeholder="可留空"/></view>
      <view class="switch-row field"><text>向访客发布本场回顾</text><switch checked="{{published}}" color="#ff6b00" bindchange="visibility"/></view><view class="field"><view class="field-label">修改说明</view><input value="{{reason}}" data-field="reason" maxlength="500" bindinput="field" placeholder="记录这次修改的依据"/></view><button class="primary full" disabled="{{busy}}" bindtap="saveStory">保存本场回顾</button>
    </view>
    <view class="section-head"><text class="section-title">评价核对</text><text class="section-index">公开前确认</text></view><view wx:for="{{queue}}" wx:key="id" class="card"><view class="row"><text class="card-title">{{item.nickname}}</text><text class="stars">{{item.starText}}</text></view><view class="small muted mt">{{item.status === 'pending' ? '待核对' : item.status === 'approved' ? '已发布' : item.status === 'withdrawn' ? '已撤回' : '未发布'}} · {{item.honorConsent ? '同意荣誉展示' : '未同意荣誉展示'}}</view><view class="paragraph review-copy">{{item.comment}}</view><block wx:if="{{item.status !== 'withdrawn'}}"><input value="{{reviewReasons[item.id]}}" data-id="{{item.id}}" maxlength="500" bindinput="reviewReason" placeholder="填写核对或不予发布的说明"/><view class="actions"><button class="primary mini" data-id="{{item.id}}" data-decision="approved" disabled="{{busy}}" bindtap="moderate">核对并发布</button><button class="secondary mini" data-id="{{item.id}}" data-decision="rejected" disabled="{{busy}}" bindtap="moderate">暂不发布</button></view></block></view><view wx:if="{{!queue.length}}" class="review-empty">本场还没有提交的评价。</view><button wx:if="{{queueCursor}}" class="secondary full" disabled="{{busy}}" bindtap="moreQueue">继续查看待核对记录</button>
  </block>
</view>
