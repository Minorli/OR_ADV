.history-heading{padding:24rpx 0 28rpx}.history-heading .title{font-size:50rpx;line-height:1.35;max-width:620rpx}.history-meta{color:#aaa;font-size:25rpx;margin-top:24rpx}.history-line{height:5rpx;width:72rpx;background:#ff6b00;margin:30rpx 0 20rpx}.history-caption{font-size:23rpx;color:#c3a48b}.photo-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.photo-tile{overflow:hidden;background:#1a1a1a;border:1rpx solid #303030;border-radius:16rpx}.photo-tile image{display:block;width:100%;height:240rpx}.photo-label{font-size:22rpx;color:#aaa;padding:14rpx 18rpx}.film{width:100%;height:388rpx;border-radius:18rpx;background:#171717}.honor-strip{background:#1c1510;border:1rpx solid #5b341c;border-radius:20rpx;padding:28rpx;margin-top:34rpx}.honor{display:flex;justify-content:space-between;align-items:center;gap:20rpx;padding:18rpx 0;border-bottom:1rpx solid #3b291c}.honor:last-child{border:0}.honor-name{font-size:29rpx;font-weight:650}.honor-label{font-size:24rpx;color:#ff9d59}.stars{color:#ff8a3d;font-size:26rpx;letter-spacing:3rpx}.review-copy{margin:23rpx 0 10rpx;font-size:26rpx;color:#d5d5d5}.review-empty{color:#999;padding:24rpx 0 38rpx;font-size:25rpx}.review-form{margin-top:32rpx}.star-choices{display:flex;gap:12rpx;margin:25rpx 0}.star-choice{padding:4rpx 10rpx;background:transparent;color:#666;font-size:48rpx;line-height:1.4}.star-choice.chosen{color:#ff8a3d}.withdraw{display:block;margin:24rpx auto 0}.intro-input{height:320rpx}.edit-photo-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12rpx}.edit-photo{position:relative;height:180rpx;border:1rpx solid #333;border-radius:12rpx;overflow:hidden;background:#151515;display:flex;align-items:center;justify-content:center}.edit-photo image{width:100%;height:100%}.remove-photo{position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,.7);padding:8rpx;font-size:20rpx;border-radius:0}
