<view class="page"><view class="eyebrow">OR ADV / MY TRIPS</view><view class="title">我的同行</view><view class="subtitle">报名进展、行前安排与每次参加的记录。</view>
  <view class="filter-row"><button wx:for="{{filters}}" wx:key="value" class="pill {{filter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</button></view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重试</button></view>
  <view wx:if="{{!loading && !member && !error}}" class="empty">先看看适合自己的活动。<text>{{'\n'}}</text>提交意向时再建立微信身份。<button class="primary full mt" bindtap="explore">查看近期活动</button></view>
  <view wx:for="{{visibleItems}}" wx:key="id" class="card"><view class="row"><text class="tag {{item.state === 'completed' && !item.completionVoided ? 'tag-dark' : ''}}">{{item.stateText}}</text><text class="tiny muted">第 {{item.attempt}} 次申请</text></view><view class="card-title mt" data-id="{{item.activityId}}" bindtap="detail">{{item.activityTitle || '俱乐部同行活动'}} →</view><view wx:if="{{item.activityDateText}}" class="activity-date small mt">{{item.activityDateText}}</view><view wx:if="{{item.locationText}}" class="small muted mt">{{item.locationText}}</view><view class="notice">{{item.progressText}}</view><view wx:if="{{item.reason}}" class="small paragraph muted">处理说明：{{item.reason}}</view><view class="actions"><button class="mini primary grow" data-id="{{item.activityId}}" bindtap="detail">{{item.state === 'confirmed' ? '查看行前安排' : '查看本场记录'}}</button><button wx:if="{{item.canCancel}}" class="mini secondary" data-id="{{item.id}}" loading="{{busy === item.id}}" disabled="{{!!busy}}" bindtap="cancel">取消申请</button></view></view>
  <view wx:if="{{loading}}" class="loading">正在加载同行记录…</view><view wx:if="{{!loading && member && !visibleItems.length && !error}}" class="empty">{{items.length ? '这个分类下暂无记录。' : '还没有申请记录，可以先看看近期活动。'}}<button wx:if="{{!items.length}}" class="primary full mt" bindtap="explore">查看近期活动</button></view><button wx:if="{{nextCursor && !loading}}" class="secondary full" bindtap="more">加载更早记录</button>
  <view class="footer-note">出发后的退出与异常，请先联系现场负责人。<text>{{'\n'}}</text>积分以完成核验后的结算流水为准。</view>
</view>
