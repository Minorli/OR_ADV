<view wx:if="{{isMock}}" class="demo">内测演示 · 数据仅保存在本机</view>
<view class="page ranking-page">
  <view class="ranking-heading"><view><view class="ranking-kicker">ORIGINAL RALLY</view><view class="ranking-title">成员排行</view></view><view class="ranking-year">{{year}} 年</view></view>
  <view class="own-score-card">
    <view class="own-score-top"><text>我的成长积分</text><text class="own-score-private">个人记录</text></view>
    <view class="own-score-line"><view class="own-score-number">{{member ? member.growthPoints : '—'}}<text wx:if="{{member}}">分</text></view><button wx:if="{{member}}" class="score-detail" bindtap="points">查看明细 <text>↗</text></button><button wx:else class="score-detail" bindtap="profile">登录查看 <text>↗</text></button></view>
    <view wx:if="{{member}}" class="own-score-meta"><text>年度积分 <text class="own-score-meta-value">{{member.annualPoints}}</text></text><view class="score-meta-divider"></view><text>完成同行 <text class="own-score-meta-value">{{member.completedCount}}</text> 次</text></view>
    <view wx:else class="own-score-meta">登录后查看自己的报名与成长记录</view>
  </view>
  <block wx:if="{{founderRail.length}}">
    <view class="ranking-section-head"><view class="ranking-section-title"><view class="orange-marker"></view>创始成员</view><text class="ranking-section-note">已同意公开推荐</text></view>
    <scroll-view scroll-x class="founder-scroll" enhanced show-scrollbar="{{false}}"><view class="founder-track"><view wx:for="{{founderRail}}" wx:key="memberPublicId" class="founder-card"><view class="founder-initial">{{item.initial}}<text>OR</text></view><view class="founder-name">{{item.nickname}}</view><view class="founder-label">创始成员</view><view class="founder-summary">{{item.hasPublicPoints ? '完成 ' + item.completedCount + ' 次同行' : '积分未公开'}}</view></view></view></scroll-view>
  </block>
  <view class="ranking-switch"><button class="ranking-switch-item {{mode === 'recommended' ? 'is-active' : ''}}" data-mode="recommended" bindtap="mode">俱乐部推荐</button><button class="ranking-switch-item {{mode === 'points' ? 'is-active' : ''}}" data-mode="points" bindtap="mode">实际积分榜</button></view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重新加载</button></view>
  <block wx:if="{{mode === 'recommended'}}">
    <view class="ranking-explainer">创始成员优先，其他顺序由俱乐部编排。推荐顺序不代表积分名次。</view>
    <view class="ranking-list"><view wx:for="{{recommendations}}" wx:key="memberPublicId" class="ranking-member-row"><view class="public-member-initial {{item.memberKind === 'founder' ? 'is-founder' : ''}}">{{item.initial}}</view><view class="public-member-body"><view class="public-member-name">{{item.nickname}}</view><view class="public-member-meta"><text class="member-kind-label {{item.memberKind === 'founder' ? 'is-founder' : ''}}">{{item.memberKind === 'founder' ? '创始成员' : '俱乐部成员'}}</text><text wx:if="{{item.hasPublicPoints}}">完成 {{item.completedCount}} 次</text></view></view><view wx:if="{{item.hasPublicPoints}}" class="public-member-score">{{item.growthPoints}}<text>成长积分</text></view><view wx:else class="private-score-label">积分未公开</view></view></view>
    <view wx:if="{{!loading && !error && !recommendations.length}}" class="empty">暂无公开推荐的成员。<text>{{'\n'}}</text>成员单独同意后，才会在这里展示。</view>
    <button wx:if="{{recommendationCursor && !loading}}" class="secondary full ranking-more" bindtap="more">查看更多成员</button>
    <button class="ranking-settings" bindtap="profile">管理我的推荐展示 <text>›</text></button>
  </block>
  <block wx:else>
    <view class="ranking-filters"><button wx:for="{{filters}}" wx:key="value" class="ranking-filter {{metric === item.value ? 'is-active' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</button></view>
    <view class="ranking-explainer">按实际记录排序，同分并列。成员身份不改变积分或名次。</view>
    <view class="ranking-list"><view wx:for="{{items}}" wx:key="memberPublicId" class="ranking-member-row"><view class="actual-rank rank-{{item.rank}}">{{item.rank}}</view><view class="public-member-initial rank-initial">{{item.initial}}</view><view class="public-member-body"><view class="public-member-name">{{item.nickname}}</view><view class="public-member-meta">完成 {{item.completedCount}} 次同行</view></view><view class="public-member-score">{{item.score}}<text>{{metric === 'completed_count' ? '次完成' : metric === 'annual' ? '年度积分' : '成长积分'}}</text></view></view></view>
    <view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无公开的积分记录。<text>{{'\n'}}</text>加入积分榜需要本人同意。</view>
    <button wx:if="{{nextCursor && !loading}}" class="secondary full ranking-more" bindtap="more">查看更多记录</button>
    <button wx:if="{{member}}" class="ranking-settings" loading="{{saving}}" disabled="{{saving}}" bindtap="optIn">{{member.rankingOptIn ? '退出公开积分榜' : '了解并自愿加入积分榜'}} <text>›</text></button><button wx:else class="ranking-settings" bindtap="profile">我的公开与隐私设置 <text>›</text></button>
  </block>
  <view wx:if="{{loading}}" class="loading">正在读取成员记录…</view>
  <view wx:if="{{contact.configured}}" class="ranking-contact" bindtap="contact"><view><view class="ranking-contact-title">联系{{contact.contactName || '组织方'}}</view><view class="ranking-contact-note">{{contact.contactInstructions || '报名、活动与记录问题'}}</view></view><text>›</text></view>
  <view class="footer-note">推荐与积分榜分别征求同意，可以随时退出。<text>{{'\n'}}</text>积分不代替技能与现场安全核验。</view>
</view>
