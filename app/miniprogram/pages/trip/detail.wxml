<view wx:if="{{isMock}}" class="demo">内测演示 · 数据仅保存在本机</view>
<view class="page"><view class="eyebrow">OR ADV / MY TRIP</view><view class="title">本场同行</view><view wx:if="{{activity}}" class="subtitle">{{activity.title}}</view>
  <view wx:if="{{loading}}" class="loading">正在核对本场安排…</view><view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">刷新最新状态</button></view>
  <view wx:if="{{!loading && !registration && !error}}" class="empty">{{member ? '你还没有本场申请记录。' : '本场参加记录仅供本人查看。'}}<button class="primary full mt" bindtap="publicActivity">查看公开活动详情</button></view>
  <block wx:if="{{registration}}">
    <view class="next-trip mt"><view class="row"><text class="tag tag-dark">{{registration.stateText}}</text><text class="tiny muted">规则 v{{registration.acceptedRuleVersion}}</text></view><view class="card-title mt">{{nextAction}}</view><view wx:if="{{activity}}" class="small muted mt">计划 {{activity.dateText}} · {{activity.location}}</view><button wx:if="{{feeHint && contact.configured}}" class="secondary full mt" bindtap="contact">{{contact.contactMethod === 'phone' ? '联系工作人员' : '复制联系信息'}}</button></view>
    <view wx:if="{{registration.reason}}" class="notice">处理说明：{{registration.reason}}</view>
    <block wx:if="{{canReadBriefing}}">
      <view class="section-head"><text class="section-title">行前安排</text><text class="section-index">PREPARATION</text></view>
      <view wx:if="{{briefingError}}" class="notice">{{briefingError}}<view class="small mt">请联系负责人核对本场安排。</view><button class="text-button" bindtap="retry">重新读取</button></view>
      <view wx:if="{{briefing}}" class="card"><view class="briefing-row"><text class="field-label">集合时间</text><view class="card-title">{{meetingText || '由负责人另行通知'}}</view></view><view class="briefing-row"><text class="field-label">集合地点</text><view class="paragraph">{{briefing.meetingPoint || '由负责人另行通知'}}</view></view><view class="briefing-row"><text class="field-label">本场负责人</text><view>{{briefing.contactName || '俱乐部工作人员'}}</view><view class="small muted mt">{{briefing.contactValue}}</view><button wx:if="{{briefing.contactValue}}" class="secondary full mt" bindtap="leader">{{briefing.contactMethod === 'phone' ? '联系本场负责人' : '复制负责人联系信息'}}</button></view><view wx:if="{{briefing.notes}}" class="briefing-row"><text class="field-label">本场须知</text><view class="small paragraph">{{briefing.notes}}</view></view></view>
      <view wx:if="{{checklist.length}}" class="card"><view class="card-title">个人准备清单</view><view class="small muted mt">勾选便于自己核对，仅保存在本机，不代表资格、报名或现场核验。</view><checkbox-group bindchange="checklist"><label wx:for="{{checklist}}" wx:key="value" class="checklist-item"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#ff6b00"/><text>{{item.label}}</text></label></checkbox-group></view>
    </block>
    <view wx:else class="notice">集合细节和参加者资料仅对符合条件的已确认参加者开放。公开活动信息仍可随时查看。</view>
    <view class="section-head"><text class="section-title">本人的现场记录</text><text class="section-index">RECORDS</text></view>
    <view class="card"><view class="record-row"><view class="record-dot"></view><view class="grow"><view>申请已提交</view><view class="tiny muted mt">{{registration.createdText}}</view></view></view><view wx:if="{{registration.confirmedAt}}" class="record-row"><view class="record-dot"></view><view class="grow"><view>已确认参加</view><view class="tiny muted mt">已通过本场参加流程</view></view></view><view wx:for="{{records}}" wx:key="id" class="record-row"><view class="record-dot"></view><view class="grow"><view>{{item.title}}</view><view class="tiny muted mt">{{item.dateText}}</view><view wx:if="{{item.reason}}" class="small muted mt">{{item.reason}}</view></view></view><view wx:if="{{!records.length && !timelineError}}" class="small muted mt">暂无现场核验记录。出发与结束由工作人员分别核对。</view><view wx:if="{{timelineError}}" class="notice error">{{timelineError}}<button class="text-button" bindtap="retry">刷新记录</button></view><button wx:if="{{timelineCursor}}" class="text-button full mt" bindtap="moreRecords">查看更多记录</button></view>
    <button wx:if="{{registration.state === 'completed' || registration.completionVoided}}" class="primary full" bindtap="points">查看成长与积分流水</button>
    <view wx:if="{{contact.configured}}" class="card mt"><view class="row"><view class="grow"><view class="card-title">联系{{contact.contactName || '组织方'}}</view><view class="small muted mt">{{contact.contactInstructions || '安排、记录或异常有疑问时，请联系工作人员。'}}</view></view><button class="mini secondary" bindtap="contact">{{contact.contactMethod === 'phone' ? '联系' : '复制联系信息'}}</button></view></view>
    <view class="actions"><button class="secondary grow" bindtap="publicActivity">公开活动详情</button><button wx:if="{{canCancel}}" class="secondary" disabled="{{busy}}" loading="{{busy}}" bindtap="cancel">取消申请</button></view>
  </block>
  <view class="footer-note">请按领队安排参加，异常与退出先联系现场负责人。<text>{{'\n'}}</text>积分在完成核验并结算后记录。</view>
</view>
