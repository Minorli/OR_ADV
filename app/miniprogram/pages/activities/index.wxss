@import '../../styles/reference-v2.wxss';
.reference-v2.home-reference{display:flex;flex-direction:column;min-height:100vh}
.reference-v2 .hero{padding:0;border-radius:0;min-height:0;height:550rpx;margin-bottom:0;margin-left:0;margin-right:0;background:#0a0a0a;flex-shrink:0}.reference-v2 .hero .hero-fit{width:100%;height:100%;background:#0a0a0a;transform:none}.reference-v2 .hero .img{transform:none}.reference-v2 .hero .brand-logo{width:72rpx;height:70rpx;display:block}.reference-v2 .hero .cap{bottom:52rpx;left:32rpx;right:32rpx}.reference-v2 .hero .cap .h2{font-size:44rpx;line-height:1.18;white-space:pre-line;text-shadow:0 2rpx 12rpx rgba(0,0,0,.65)}.reference-v2 .hero .cap .p{font-size:23rpx;color:#d0d0d0;margin-top:8rpx}
.reference-v2 .sponsor-band{margin-top:auto;margin-bottom:0;flex-shrink:0}.reference-v2 .sponsor-marquee-viewport{width:100%;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent 0%,#000 7%,#000 93%,transparent 100%);mask-image:linear-gradient(90deg,transparent 0%,#000 7%,#000 93%,transparent 100%)}.reference-v2 .sponsor-marquee-track{display:flex;width:max-content;animation:sponsorScroll 26s linear infinite;will-change:transform}.reference-v2 .sponsor-marquee-track.is-paused{animation-play-state:paused}.reference-v2 .sponsor-marquee-group{display:flex;flex-shrink:0;gap:14rpx;padding-right:14rpx}.reference-v2 .sponsor-logos .sp{width:148rpx;height:52rpx;padding:7rpx 14rpx;background:rgba(255,255,255,.025);border:1rpx solid rgba(255,255,255,.055);border-radius:10rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}.reference-v2 .sponsor-logo{width:100%;height:100%;opacity:.86}
@keyframes sponsorScroll{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
.reference-v2 .reference-cover{position:absolute;inset:0;width:100%;height:100%;display:block}.reference-v2 .reference-cover-fallback{background:linear-gradient(135deg,#322519,#161616)}.reference-v2 .reference-hero-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.45) 58%,#0a0a0a)}.reference-v2 .hero .img::after,.reference-v2 .act .thumb::after{display:none}.reference-v2 .reference-act-shade{position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,rgba(0,0,0,.7))}.reference-v2 .hero .dots .i{display:block}.reference-v2 .act .thumb .nm,.reference-v2 .act .thumb .lvl,.reference-v2 .act .thumb .days{z-index:1}
