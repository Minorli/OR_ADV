<view wx:if="{{isMock}}" class="demo">本机演示 · 人物与活动均为虚构</view>
<view class="home">
  <view class="home-hero">
    <swiper class="ride-swiper" autoplay circular interval="6000" duration="450" bindchange="heroChange" current="{{heroCurrent}}">
      <swiper-item wx:for="{{heroSlides}}" wx:key="id">
        <view class="hero-slide cover-fallback">
          <image wx:if="{{!coverErrors[item.cover]}}" class="hero-photo" src="{{item.cover}}" mode="aspectFill" data-src="{{item.cover}}" binderror="coverError"/>
          <view class="hero-shade"></view>
          <view class="hero-copy"><view class="hero-kicker">{{item.kicker}}</view><view class="hero-headline">{{item.title}}</view><view class="hero-caption">{{item.caption}}</view><button wx:if="{{item.id === 'practice'}}" class="hero-practice-link" bindtap="learning">打开知识练习 <text>↗</text></button></view>
        </view>
      </swiper-item>
    </swiper>
    <view class="hero-topbar"><view class="hero-brand"><view class="or-logo">OR</view><view><view class="brand-cn">原始拉力</view><view class="brand-en">ADV MOTORCYCLE CLUB</view></view></view><button class="hero-profile" bindtap="profile">{{member ? kindLabel : '我的'}} ↗</button></view>
    <view class="hero-bottom"><view class="hero-dots"><view wx:for="{{heroSlides}}" wx:key="id" class="hero-dot {{heroCurrent === index ? 'selected' : ''}}"></view></view><text class="cover-note">示意封面</text></view>
  </view>

  <view class="home-content">
    <view class="ride-principles"><view class="principle"><view class="principle-name">准备好，再出发</view><view class="principle-caption">资格与装备，逐场核对</view></view><view class="principle"><view class="principle-name">每次完成，都记得</view><view class="principle-caption">经历与积分，按记录结算</view></view></view>
    <view wx:if="{{nextTrip}}" class="home-next">
      <view class="next-top"><text class="next-kicker">我的本场同行</text><text class="next-status">{{nextTrip.stateText}}</text></view>
      <view class="next-title">{{nextTrip.title}}</view><view wx:if="{{nextTrip.dateText}}" class="next-date">{{nextTrip.dateText}}</view>
      <view class="next-copy">{{nextTrip.nextAction}}</view><button class="next-button" bindtap="trip">{{nextTrip.buttonLabel}}<text>→</text></button>
    </view>
    <view wx:elif="{{member}}" class="home-welcome"><text class="welcome-dot"></text><view><view class="welcome-title">{{member.nickname}}，下一场见</view><view class="welcome-copy">{{member.memberKind === 'founder' ? '选一场合适的活动，核对条件后出发。' : '查看近期活动，提交意向后等待工作人员确认。'}}</view></view></view>
    <view wx:if="{{personalError}}" class="notice error">个人记录暂时未能读取：{{personalError}}<button class="text-button" bindtap="retry">重新核对</button></view>

    <view class="activity-heading"><view><view class="section-kicker">FIND YOUR NEXT RIDE</view><view class="activity-section-title">近期活动</view></view><button class="history-link" bindtap="history">查看往期 ›</button></view>
    <scroll-view scroll-x class="activity-filters" enhanced show-scrollbar="{{false}}"><view class="filter-track"><button wx:for="{{filters}}" wx:key="value" class="activity-filter {{filter === item.value ? 'selected' : ''}}" data-value="{{item.value}}" bindtap="filter">{{item.label}}</button></view></scroll-view>
    <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重新加载</button></view>
    <view wx:for="{{displayItems}}" wx:key="id" class="ride-card" data-id="{{item.id}}" bindtap="open">
      <view class="ride-thumb cover-fallback"><image wx:if="{{!coverErrors[item.cover]}}" class="ride-photo" src="{{item.cover}}" mode="aspectFill" data-src="{{item.cover}}" binderror="coverError"/><view class="ride-photo-shade"></view>
        <view class="ride-level"><view class="level-bars"><view wx:for="{{item.difficultyBars}}" wx:for-item="bar" wx:key="id" class="level-bar {{bar.active ? 'on' : ''}}"></view></view><text>{{item.difficulty}}</text></view><view class="ride-duration">{{item.durationText}}</view>
        <view class="ride-thumb-title">{{item.title}}</view>
      </view>
      <view class="ride-meta"><view class="ride-calendar"><text class="calendar-month">{{item.monthText}}月</text><text class="calendar-day">{{item.dayText}}</text></view><view class="ride-meta-copy"><view class="ride-date">{{item.dateText}} <text>{{item.weekdayText}}</text></view><view class="ride-location">{{item.location}}</view></view></view>
      <view class="ride-footer"><view class="ride-seats">{{item.seatText}}</view><view class="ride-state {{item.statusTone}}">{{item.stateText}}<text>›</text></view></view>
    </view>
    <view wx:if="{{loading}}" class="loading">正在加载活动…</view><view wx:if="{{!loading && !error && !items.length}}" class="empty">暂无符合筛选的活动。<text>{{'\n'}}</text>可以切换筛选，或稍后再来看看。</view><button wx:if="{{nextCursor && !loading}}" class="secondary full more-activities" bindtap="more">查看更多活动 ↓</button>
    <view wx:if="{{partnersConfigured}}" class="home-partners"><view class="partners-heading"><view><view class="section-kicker">CLUB PARTNERS</view><view class="activity-section-title">{{partnersTitle}}</view></view><button class="history-link" bindtap="partners">了解合作 ›</button></view><view wx:if="{{partnersIntroduction}}" class="partners-introduction">{{partnersIntroduction}}</view><scroll-view wx:if="{{partners.length}}" scroll-x class="partners-scroll" show-scrollbar="{{false}}"><view class="partners-track"><view wx:for="{{partners}}" wx:key="heading" class="partner-card" bindtap="partners"><view class="partner-name">{{item.heading}}</view><view class="partner-introduction">{{item.introduction}}</view><text class="partner-arrow">↗</text></view></view></scroll-view></view>
    <view wx:if="{{partnersError}}" class="notice">合作信息暂时未能读取。<button class="text-button" bindtap="retryPartners">重新读取合作信息</button></view>
    <view class="home-footer"><view class="footer-wordmark">ORIGINAL RALLY</view><view>按能力参与 · 按规则同行 · 平安返回</view><view class="footer-small">成员身份与积分不替代技能和现场安全核验。</view></view>
  </view>
</view>
