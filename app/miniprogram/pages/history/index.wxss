.archive-top{display:flex;align-items:center;justify-content:space-between}.archive-top .tag{color:#ff9d59;border-color:#74401d;background:#22170e}.archive-intro{font-size:25rpx;color:#aaa;margin-top:15rpx;margin-bottom:22rpx}.archive-tools{margin-bottom:28rpx}.archive-months{width:100%;white-space:nowrap}.archive-month-track{display:inline-flex;gap:12rpx;padding:4rpx 0 10rpx}.archive-search{position:relative;margin-top:16rpx}.archive-search input{height:82rpx;padding-left:70rpx;background:#1a1a1a;border-color:#303030;font-size:25rpx}.archive-search-icon{position:absolute;left:25rpx;top:25rpx;width:25rpx;height:25rpx;z-index:1;border:3rpx solid #aaa;border-radius:50%}.archive-search-icon::after{content:"";position:absolute;width:13rpx;height:3rpx;background:#aaa;transform:rotate(45deg);right:-9rpx;bottom:-4rpx}.archive-placeholder{color:#999}.archive-card{border:1rpx solid #303030;border-radius:22rpx;background:#1a1a1a;overflow:hidden;margin-bottom:28rpx}.archive-cover{height:300rpx;position:relative;overflow:hidden;background:linear-gradient(135deg,#402918,#171717)}.archive-image{position:absolute;inset:0;width:100%;height:100%}.archive-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.08),rgba(0,0,0,.08) 30%,rgba(0,0,0,.86))}.archive-duration,.archive-cover-label{position:absolute;top:18rpx;right:18rpx;padding:4rpx 13rpx;background:rgba(0,0,0,.65);border-radius:30rpx;color:#eee;font-size:20rpx}.archive-cover-label{left:18rpx;right:auto;color:#d0d0d0}.archive-cover-title{position:absolute;left:26rpx;right:24rpx;bottom:22rpx;color:#fff;font-size:34rpx;font-weight:700;line-height:1.4}.archive-body{padding:25rpx 26rpx 0}.archive-location{font-size:25rpx;color:#ddd}.archive-date{font-size:23rpx;color:#aaa;margin-top:8rpx}.archive-facts{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;border-top:1rpx solid #333;margin-top:22rpx;padding-top:22rpx}.archive-fact-label,.archive-fact-value{display:block;font-size:21rpx;color:#aaa}.archive-fact-value{color:#ddd;font-size:24rpx;margin-top:8rpx}.archive-foot{display:flex;align-items:center;justify-content:space-between;gap:10rpx;border-top:1rpx solid #303030;margin-top:22rpx;padding:21rpx 0;color:#aaa;font-size:23rpx}.archive-open{color:#ff923f}.archive-end{text-align:center;color:#999;font-size:23rpx;padding:18rpx 0 12rpx}
