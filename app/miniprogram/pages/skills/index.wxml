<view class="page skills-page"><view class="skills-kicker">PRACTICE / REVIEW</view><view class="skills-title">把每次练习记下来</view><view class="skills-intro">查看练习项目，提交视频，跟进复核结果。</view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重试</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}" class="loading">正在加载练习记录…</view>
  <view wx:if="{{!loading && !member}}" class="card"><view class="card-title">保存自己的练习记录</view><view class="small muted mt">登录后查看项目、提交视频及负责人反馈。</view><button class="primary full mt" bindtap="profile">前往登录</button></view>
  <block wx:if="{{member}}"><view class="skills-tabs"><button class="skills-tab {{level === 'basic' ? 'is-active' : ''}}" data-level="basic" bindtap="level">基础练习 <text>5 项</text></button><button class="skills-tab {{level === 'advanced' ? 'is-active' : ''}}" data-level="advanced" bindtap="level">进阶练习 <text>7 项</text></button></view><view class="skills-overview"><view><text class="skills-count">{{approvedCount}}</text><text class="skills-count-total"> / {{visibleItems.length}}</text><view class="small muted mt">练习记录已复核</view></view><view class="skills-pending">{{submittedCount}} 项待复核</view></view><view class="skills-policy">考核与准入标准待主理人确认。视频复核记录不自动授予活动资格，也不增加积分。</view>
    <view wx:for="{{visibleItems}}" wx:key="id" class="skill-row" data-id="{{item.id}}" bindtap="open"><view class="skill-number">{{item.number}}</view><view class="skill-row-copy"><view class="skill-name">{{item.title}}</view><view class="skill-status {{item.submission.state === 'approved' ? 'is-reviewed' : ''}}">{{item.stateText}}</view></view><view class="skill-arrow">›</view></view>
    <view wx:if="{{selected}}" class="card skill-detail"><view class="skill-detail-heading"><view class="card-title">{{selected.title}}</view><button class="text-button" bindtap="close">收起</button></view><view class="small muted mt">{{selected.description}}</view><block wx:if="{{selected.reference}}"><view class="skill-label">负责人核实的示范资料</view><video src="{{selected.reference.url}}" class="skill-video" controls enable-play-gesture show-center-play-btn binderror="videoFailed"/><view class="tiny muted mt">{{selected.reference.title}}</view></block><view wx:else class="skill-reference-empty">本项目尚未提供经核实的示范视频。练习安排请先联系指导人员。</view><block wx:if="{{selected.submission}}"><view class="skill-record-box"><view class="card-title">{{selected.stateText}}</view><view wx:if="{{selected.submission.reviewReason}}" class="small mt">{{selected.submission.reviewReason}}</view><view wx:if="{{selected.submission.note}}" class="small muted mt">提交说明：{{selected.submission.note}}</view><button class="text-button mt" bindtap="viewOwnVideo">查看已提交的视频</button><button class="text-button mt" bindtap="history" disabled="{{busy}}">查看历次练习与复核</button><button wx:if="{{selected.submission.state !== 'withdrawn'}}" class="text-button" bindtap="cancel" disabled="{{busy}}">撤回这次练习记录</button></view></block><view class="skill-label">提交本人练习</view><view class="small muted">MP4 / MOV · 60 秒以内 · 8 MB 以内。选择并保存真实文件后才能提交。</view><checkbox-group bindchange="consent"><label class="check-line mt"><checkbox value="accepted" checked="{{mediaConsent}}" color="#ff6b00"/><text>这是本人练习片段，我有权上传。仅供本人和授权主理人核对，不作公开展示。</text></label></checkbox-group><button class="secondary full mt" bindtap="upload" disabled="{{busy}}" loading="{{busy}}">{{assetId ? '重新选择练习短片' : '选择并保存练习短片'}}</button><video wx:if="{{previewUrl}}" src="{{previewUrl}}" class="skill-video mt" controls show-center-play-btn binderror="videoFailed"/><view wx:if="{{assetId}}" class="skill-upload-ready">视频已保存，尚未提交复核</view><view class="field"><text class="field-label">练习说明（选填）</text><textarea value="{{note}}" data-field="note" bindinput="field" maxlength="600" placeholder="练习时间、场地、指导人员及希望得到的反馈"/></view><button class="primary full" bindtap="submit" disabled="{{busy || !assetId}}" loading="{{busy}}">提交给负责人复核</button><block wx:for="{{drafts}}" wx:key="id"><view wx:if="{{item.label === selected.title}}" class="skill-draft"><view><view class="small">待上传的短片</view><view class="tiny muted mt">{{item.label}} · 尚未提交审核</view></view><button class="text-button" data-id="{{item.id}}" bindtap="retryDraft" disabled="{{busy}}">重试保存</button></view></block>
      <button wx:if="{{isOwner}}" class="text-button full mt" bindtap="toggleReference">{{referenceEditor ? '收起示范资料维护' : '维护本项目示范资料'}}</button><view wx:if="{{referenceEditor}}" class="skill-reference-editor"><view class="field"><text class="field-label">视频标题</text><input value="{{referenceTitle}}" data-field="referenceTitle" bindinput="field" maxlength="100"/></view><view class="field"><text class="field-label">HTTPS 视频地址</text><input value="{{referenceUrl}}" data-field="referenceUrl" bindinput="field" maxlength="1000" placeholder="使用已核实且可在微信播放的素材"/></view><view class="field"><text class="field-label">来源核实说明</text><textarea value="{{referenceReason}}" data-field="referenceReason" bindinput="field" maxlength="500"/></view><checkbox-group bindchange="referenceConsent"><label class="check-line"><checkbox value="verified" checked="{{referenceVerified}}" color="#ff6b00"/><text>已核实来源、内容及使用权限</text></label></checkbox-group><button class="secondary full mt" bindtap="saveReference" disabled="{{busy}}">保存示范资料</button></view>
    </view>
    <button class="text-button full mt" bindtap="learning">查看安全知识练习 ›</button><button wx:if="{{isOwner}}" class="secondary full mt" bindtap="toggleReview">{{reviewMode ? '收起待复核记录' : '主理人 · 复核练习记录'}}</button>
    <view wx:if="{{reviewMode}}" class="card skill-review-panel"><view class="card-title">待复核练习</view><view wx:if="{{!queue.length}}" class="skill-reference-empty">当前没有待复核记录。</view><view wx:for="{{queue}}" wx:key="id" class="skill-review-row" data-id="{{item.id}}" bindtap="reviewOpen"><view><view class="card-title">{{item.nickname}} · {{item.skillTitle}}</view><view class="tiny muted mt">成员编号 {{item.memberNumber === undefined ? '待分配' : item.memberNumber}}</view></view><text>›</text></view><button wx:if="{{nextCursor}}" class="secondary full mt" bindtap="moreQueue">查看更多待复核记录</button><view wx:if="{{reviewTarget}}" class="skill-review-detail"><view class="card-title">{{reviewTarget.nickname}} · {{reviewTarget.skillTitle}}</view><view wx:if="{{reviewTarget.note}}" class="small muted mt">{{reviewTarget.note}}</view><video wx:if="{{reviewVideoUrl}}" class="skill-video mt" src="{{reviewVideoUrl}}" controls show-center-play-btn binderror="videoFailed"/><button class="text-button full mt" bindtap="reviewHistory" disabled="{{busy}}">查看这位成员的历次记录</button><view class="field"><text class="field-label">复核依据与补充建议</text><textarea value="{{reviewReason}}" data-field="reviewReason" bindinput="field" maxlength="600"/></view><button class="primary full" data-decision="approved" bindtap="review" disabled="{{busy || !reviewVideoUrl}}">记录复核完成</button><button class="secondary full mt" data-decision="changes_requested" bindtap="review" disabled="{{busy || !reviewVideoUrl}}">退回补充记录</button><view class="tiny muted mt">此操作仅保存练习复核，活动资格需在成员管理中另行核定。</view></view></view>
    <view wx:if="{{historyLoaded}}" class="card skill-history"><view class="card-title">{{historyTitle}}</view><view class="small muted mt">每次提交、复核和撤回分别留档，保留当时的视频与说明。</view><view wx:for="{{historyItems}}" wx:key="historyId" class="skill-history-row"><view class="skill-history-top"><text>版本 {{item.revision}} · {{item.stateText}}</text><text class="tiny muted">{{item.dateText}}</text></view><view wx:if="{{item.note}}" class="small mt">{{item.note}}</view><view wx:if="{{item.reviewReason}}" class="small muted mt">复核意见：{{item.reviewReason}}</view><button class="text-button" data-id="{{item.historyId}}" bindtap="historyVideo" disabled="{{busy}}">查看本版视频</button></view><view wx:if="{{!historyItems.length}}" class="small muted mt">当前没有历次记录。</view><view wx:if="{{historyMissing}}" class="tiny muted mt">本批有 {{historyMissing}} 个早期版本尚无独立归档。</view><button wx:if="{{historyCursor}}" class="secondary full mt" bindtap="moreHistory" disabled="{{busy}}">查看更早版本</button><video wx:if="{{historyVideoUrl}}" class="skill-video mt" src="{{historyVideoUrl}}" controls show-center-play-btn binderror="videoFailed"/></view>
  </block>
</view>
