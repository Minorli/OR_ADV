<view class="page reference-v2 skills-leaf {{embedded ? 'is-embedded' : ''}}"><view class="v2-modal-content"><view class="bdy"><button class="reference-close" bindtap="referenceClose" aria-label="关闭控车考核">✕</button><view class="ic-big"><image class="svg" src="/assets/icons/v2-video.png" mode="aspectFit"/></view><text class="h3">{{selected ? selected.title : level === 'advanced' ? '进阶控车考核' : '基础控车考核'}}</text><text class="sub">{{selected ? selected.description : level === 'advanced' ? '7 项进阶动作，循序完成并交由负责人复核' : '5 项基础动作，查看示范并上传本人的练习视频'}}</text>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重试</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}" class="loading">正在加载练习记录…</view>  <view wx:if="{{!loading && !member}}" class="card"><view class="card-title">保存自己的练习记录</view><view class="small muted mt">登录后查看项目、提交视频及负责人反馈。</view><button class="btn primary full mt" bindtap="profile">前往登录</button></view><block wx:if="{{member}}"><block wx:if="{{!selected}}"><view class="assess-list"><button wx:for="{{visibleItems}}" wx:key="id" class="ai" data-id="{{item.id}}" bindtap="open"><view class="pl"><text class="b">{{item.title}}</text><text class="span">{{item.description}}</text></view><text class="st2 {{item.submission.state === 'approved' ? 'p' : item.submission.state === 'submitted' ? 'w' : 'l'}}">{{item.stateText}}</text><text class="item-arrow">›</text></button></view><view class="warn-box mt"><text class="ic">?</text><view class="tx"><text class="h4">需要指导？</text><text class="p">在车队核心成员中了解领队职责，按组织方公布的联系办法咨询练习安排。</text></view></view><view class="acts"><button class="btn ghost" bindtap="referenceClose">关闭</button></view></block>
    <view wx:if="{{selected}}" class="skill-detail"><block wx:if="{{selected.reference}}"><video src="{{selected.reference.url}}" class="skill-video" controls enable-play-gesture show-center-play-btn binderror="videoFailed"/><view class="tiny muted mt">{{selected.reference.title}}</view></block><view wx:else class="video-card reference-unavailable"><view class="ply"><view class="i"></view></view><text class="vt">示范资料待负责人核实</text></view><block wx:if="{{selected.submission}}"><view class="skill-record-box"><view class="card-title">{{selected.stateText}}</view><view wx:if="{{selected.submission.reviewReason}}" class="small mt">{{selected.submission.reviewReason}}</view><view wx:if="{{selected.submission.note}}" class="small muted mt">提交说明：{{selected.submission.note}}</view><button class="text-button mt" bindtap="viewOwnVideo">查看已提交的视频</button><button class="text-button mt" bindtap="history" disabled="{{busy}}">查看历次练习与复核</button><button wx:if="{{selected.submission.state !== 'withdrawn'}}" class="text-button" bindtap="cancel" disabled="{{busy}}">撤回这次练习记录</button></view></block><view class="skill-label">提交本人练习</view><view class="small muted">MP4 / MOV · 60 秒以内 · 8 MB 以内。选择并保存真实文件后才能提交。</view><checkbox-group bindchange="consent"><label class="check-line mt"><checkbox value="accepted" checked="{{mediaConsent}}" color="#ff6b00"/><text>这是本人练习片段，我有权上传。仅供本人和授权主理人核对，不作公开展示。</text></label></checkbox-group><button class="upload-box {{assetId ? 'drag' : ''}}" bindtap="upload" disabled="{{busy}}" loading="{{busy}}"><image class="upload-icon" src="/assets/icons/v2-upload.png" mode="aspectFit"/><text class="p">{{assetId ? '视频已保存，可重新选择' : '点击选择本人的练习视频'}}</text><text class="muted">MP4 / MOV · 60秒以内 · 8MB以内</text></button><video wx:if="{{previewUrl}}" src="{{previewUrl}}" class="skill-video mt" controls show-center-play-btn binderror="videoFailed"/><view wx:if="{{assetId}}" class="skill-upload-ready">视频已保存，尚未提交复核</view><view class="field"><text class="field-label">练习说明（选填）</text><textarea value="{{note}}" data-field="note" bindinput="field" maxlength="600" placeholder="练习时间、场地、指导人员及希望得到的反馈"/></view><view class="acts"><button class="btn ghost" bindtap="close" disabled="{{busy}}">返回列表</button><button class="btn primary" bindtap="submit" disabled="{{busy || !assetId}}" loading="{{busy}}">提交审核</button></view><block wx:for="{{drafts}}" wx:key="id"><view wx:if="{{item.label === selected.title}}" class="skill-draft"><view><view class="small">待上传的短片</view><view class="tiny muted mt">{{item.label}} · 尚未提交审核</view></view><button class="text-button" data-id="{{item.id}}" bindtap="retryDraft" disabled="{{busy}}">重试保存</button></view></block>
      <button wx:if="{{canManageContent}}" class="text-button full mt" bindtap="toggleReference">{{referenceEditor ? '收起示范资料维护' : '维护本项目示范资料'}}</button><view wx:if="{{referenceEditor}}" class="skill-reference-editor"><view class="field"><text class="field-label">视频标题</text><input value="{{referenceTitle}}" data-field="referenceTitle" bindinput="field" maxlength="100"/></view><view class="field"><text class="field-label">HTTPS 视频地址</text><input value="{{referenceUrl}}" data-field="referenceUrl" bindinput="field" maxlength="1000" placeholder="使用已核实且可在微信播放的素材"/></view><view class="field"><text class="field-label">来源核实说明</text><textarea value="{{referenceReason}}" data-field="referenceReason" bindinput="field" maxlength="500"/></view><checkbox-group bindchange="referenceConsent"><label class="check-line"><checkbox value="verified" checked="{{referenceVerified}}" color="#ff6b00"/><text>已核实来源、内容及使用权限</text></label></checkbox-group><button class="btn ghost secondary full mt" bindtap="saveReference" disabled="{{busy}}">保存示范资料</button></view>
    </view><view class="v2-extra"><view wx:if="{{!embedded && !selected}}" class="skills-tabs"><button class="btn ghost" data-level="basic" bindtap="level">基础控车</button><button class="btn ghost" data-level="advanced" bindtap="level">进阶控车</button></view><view class="muted skill-policy">视频复核、活动资格和积分分别记录。</view>    <button class="text-button full mt" bindtap="learning">查看安全知识练习 ›</button><button wx:if="{{isOwner}}" class="btn ghost secondary full mt" bindtap="toggleReview">{{reviewMode ? '收起待复核记录' : '主理人 · 复核练习记录'}}</button>
    <view wx:if="{{reviewMode}}" class="card skill-review-panel"><view class="card-title">待复核练习</view><view wx:if="{{!queue.length}}" class="skill-reference-empty">当前没有待复核记录。</view><view wx:for="{{queue}}" wx:key="id" class="skill-review-row" data-id="{{item.id}}" bindtap="reviewOpen"><view><view class="card-title">{{item.nickname}} · {{item.skillTitle}}</view><view class="tiny muted mt">成员编号 {{item.memberNumber === undefined ? '待分配' : item.memberNumber}}</view></view><text>›</text></view><button wx:if="{{nextCursor}}" class="btn ghost secondary full mt" bindtap="moreQueue">查看更多待复核记录</button><view wx:if="{{reviewTarget}}" class="skill-review-detail"><view class="card-title">{{reviewTarget.nickname}} · {{reviewTarget.skillTitle}}</view><view wx:if="{{reviewTarget.note}}" class="small muted mt">{{reviewTarget.note}}</view><video wx:if="{{reviewVideoUrl}}" class="skill-video mt" src="{{reviewVideoUrl}}" controls show-center-play-btn binderror="videoFailed"/><button class="text-button full mt" bindtap="reviewHistory" disabled="{{busy}}">查看这位成员的历次记录</button><view class="field"><text class="field-label">复核依据与补充建议</text><textarea value="{{reviewReason}}" data-field="reviewReason" bindinput="field" maxlength="600"/></view><button class="btn primary full" data-decision="approved" bindtap="review" disabled="{{busy || !reviewVideoUrl}}">记录复核完成</button><button class="btn ghost secondary full mt" data-decision="changes_requested" bindtap="review" disabled="{{busy || !reviewVideoUrl}}">退回补充记录</button><view class="tiny muted mt">此操作仅保存练习复核，活动资格需在成员管理中另行核定。</view></view></view>
    <view wx:if="{{historyLoaded}}" class="card skill-history"><view class="card-title">{{historyTitle}}</view><view class="small muted mt">每次提交、复核和撤回分别留档，保留当时的视频与说明。</view><view wx:for="{{historyItems}}" wx:key="historyId" class="skill-history-row"><view class="skill-history-top"><text>版本 {{item.revision}} · {{item.stateText}}</text><text class="tiny muted">{{item.dateText}}</text></view><view wx:if="{{item.note}}" class="small mt">{{item.note}}</view><view wx:if="{{item.reviewReason}}" class="small muted mt">复核意见：{{item.reviewReason}}</view><button class="text-button" data-id="{{item.historyId}}" bindtap="historyVideo" disabled="{{busy}}">查看本版视频</button></view><view wx:if="{{!historyItems.length}}" class="small muted mt">当前没有历次记录。</view><view wx:if="{{historyMissing}}" class="tiny muted mt">本批有 {{historyMissing}} 个早期版本尚无独立归档。</view><button wx:if="{{historyCursor}}" class="btn ghost secondary full mt" bindtap="moreHistory" disabled="{{busy}}">查看更早版本</button><video wx:if="{{historyVideoUrl}}" class="skill-video mt" src="{{historyVideoUrl}}" controls show-center-play-btn binderror="videoFailed"/></view></view></block></view></view></view>