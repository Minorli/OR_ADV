.skills-page{padding-top:34rpx}.skills-kicker{font-size:19rpx;color:#ff6b00;letter-spacing:4rpx}.skills-title{font-size:42rpx;font-weight:700;margin-top:14rpx}.skills-intro{font-size:24rpx;color:#999;line-height:1.7;margin:14rpx 0 30rpx}.skills-tabs{display:flex;background:#191919;border-radius:16rpx;padding:7rpx;gap:8rpx}.skills-tab{flex:1;background:transparent;font-size:26rpx;color:#a3a3a3;padding:20rpx 0;line-height:1.4;border-radius:12rpx}.skills-tab text{font-size:20rpx;margin-left:8rpx}.skills-tab.is-active{background:#ff6b00;color:#0a0a0a;font-weight:600}.skills-overview{display:flex;align-items:center;justify-content:space-between;margin:36rpx 0 24rpx;padding:0 6rpx}.skills-count{font-size:74rpx;font-weight:700;line-height:1;color:#f5f5f5}.skills-count-total{font-size:28rpx;color:#858585}.skills-pending{font-size:23rpx;color:#ffa762;padding:12rpx 20rpx;background:#281b12;border-radius:30rpx}.skills-policy{font-size:22rpx;line-height:1.8;color:#919191;padding-bottom:22rpx}.skill-row{display:flex;align-items:center;gap:24rpx;padding:30rpx 8rpx;border-top:1rpx solid #292929}.skill-number{font-size:28rpx;color:#626262;width:42rpx;flex-shrink:0}.skill-row-copy{flex:1}.skill-name{font-size:29rpx;font-weight:600}.skill-status{font-size:22rpx;color:#999;margin-top:12rpx}.skill-status.is-reviewed{color:#66bc8c}.skill-arrow{font-size:42rpx;color:#666}.skill-detail{margin-top:24rpx;padding:30rpx}.skill-detail-heading{display:flex;align-items:center;justify-content:space-between}.skill-detail-heading button{margin:0}.skill-label{font-size:26rpx;font-weight:600;margin:34rpx 0 18rpx}.skill-reference-empty{font-size:24rpx;color:#929292;line-height:1.8;padding:24rpx 0}.skill-video{width:100%;height:360rpx;border-radius:14rpx;background:#080808}.skill-record-box{padding:24rpx;background:#222;border-radius:14rpx;margin-top:24rpx}.skill-record-box .text-button{margin:12rpx 0 0;padding:0;text-align:left}.skill-detail .check-line,.skill-reference-editor .check-line{font-size:23rpx;line-height:1.7}.skill-upload-ready{color:#70bf96;font-size:23rpx;margin-top:18rpx}.skill-detail textarea,.skill-review-detail textarea{width:100%;box-sizing:border-box;min-height:130rpx}.skill-draft{display:flex;align-items:center;justify-content:space-between;gap:10rpx;padding:22rpx;margin-top:22rpx;background:#292017;border-radius:12rpx}.skill-draft button{margin:0;flex-shrink:0}.skill-reference-editor{border-top:1rpx solid #363636;margin-top:20rpx;padding-top:6rpx}.skill-review-panel{margin-top:26rpx;padding:28rpx}.skill-review-row{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #303030}.skill-review-row text{font-size:36rpx;color:#999}.skill-review-detail{padding-top:30rpx;margin-top:24rpx;border-top:1rpx solid #444}

.skill-history{margin-top:28rpx;padding:30rpx}.skill-history-row{padding:26rpx 0;border-bottom:1rpx solid #303030}.skill-history-row:last-child{border-bottom:0}.skill-history-top{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;font-size:23rpx;line-height:1.7}.skill-history-row .text-button{padding:10rpx 0;margin:10rpx 0 0;text-align:left;font-size:22rpx}
