<view class="page reference-v2 club-leaf {{embedded ? 'is-embedded' : ''}}"><view class="{{section === 'core' ? 'v2-sheet-content' : 'v2-modal-content'}}"><view wx:if="{{section === 'core'}}" class="grip"></view><view class="shd"><text class="h3">{{content ? content.title : sectionLabels[sectionIndex]}}</text><button class="x" bindtap="referenceClose" aria-label="关闭栏目">✕</button></view><view class="bdy">
<view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry" disabled="{{busy}}">重试</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}" class="loading">正在加载内容…</view>
<block wx:if="{{mode === 'view'}}">
  <text wx:if="{{content.introduction}}" class="muted introduction">{{content.introduction}}</text>
  <block wx:if="{{section === 'core'}}"><view wx:for="{{content.people}}" wx:key="index" class="role-card"><view class="hd"><view class="av">{{item.avatarText || item.name}}</view><view><view class="nm">{{item.name}} <text class="tag g">{{item.duty}}</text></view><text wx:if="{{item.introduction}}" class="rl">{{item.introduction}}</text><text wx:if="{{item.distanceKm !== undefined && item.distanceKm !== null}}" class="km">累计里程 {{item.distanceKm}} km</text><text wx:if="{{item.serviceText}}" class="km">{{item.serviceText}}</text></view></view><view class="resp"><text class="b">主要职责</text><text wx:for="{{item.responsibilities}}" wx:key="index" wx:for-item="responsibility" class="span">· {{responsibility}}</text><text wx:if="{{item.experience}}" class="span experience">{{item.experience}}</text></view></view><view wx:if="{{!content || !content.people.length}}" class="role-card"><view class="hd"><view class="av">OR</view><view><view class="nm">核心成员与职责</view><text class="rl">公开介绍确认后在这里公布</text></view></view><view class="resp"><text class="b">主要职责</text><text class="span">尚未发布核心职责资料。</text></view></view><view class="warn-box mt"><text class="ic">?</text><view class="tx"><text class="h4">想找领队学习？</text><text class="p">先了解对应职责，再按组织方公布的联系办法咨询练习安排。</text></view></view></block>
  <block wx:elif="{{section === 'contacts'}}"><view wx:for="{{contactGroups}}" wx:key="title" wx:for-item="group"><view class="sec-t"><text class="b">{{group.title}}</text><view class="ln"></view></view><view wx:for="{{group.items}}" wx:key="index" wx:for-item="contact" class="ct-line"><image class="ic" src="{{contact.method === 'address' ? '/assets/icons/v2-map.png' : '/assets/icons/v2-phone.png'}}" mode="aspectFit"/><view class="tx"><text class="b">{{contact.label}}</text><text wx:if="{{contact.name}}" class="span">{{contact.name}}</text><text class="span">{{contact.value}}</text><text wx:if="{{contact.hours}}" class="span">{{contact.hours}}</text><text wx:if="{{contact.note}}" class="span">{{contact.note}}</text><button class="text-button" data-index="{{contact.index}}" bindtap="contact">{{contact.action}} ›</button></view></view><view wx:if="{{!group.items.length}}" class="ct-line"><image class="ic" src="/assets/icons/v2-phone.png" mode="aspectFit"/><view class="tx"><text class="b">{{group.title === '核心技师' ? '技师与工作室' : group.title === '紧急救援' ? '救援联络' : '俱乐部联络'}}</text><text class="span">本项联系办法由组织方核实后公布。</text></view></view></view><view class="ct-role"><text class="b">加入俱乐部</text><text class="p">入队条件与办理办法以组织方公布的说明为准。</text></view></block>
  <block wx:elif="{{section === 'points'}}"><view class="ic-big"><image src="/assets/icons/v2-rules.png" mode="aspectFit"/></view><text class="sub">成长、年度与兑换积分分别记录</text><view wx:for="{{rulesSections}}" wx:key="title" class="rule-section"><text class="h4">{{item.title}}</text><view class="assess-list"><view class="ai"><view class="pl"><text class="span rule-copy">{{item.body || '组织方核定后在这里公布。'}}</text></view></view></view></view><button class="btn primary mt" bindtap="referenceClose">明白了</button></block>
  <view wx:for="{{content.blocks}}" wx:key="index" wx:if="{{section !== 'points'}}" class="content-block"><text class="h4">{{item.heading}}</text><text class="p">{{item.body}}</text></view><view wx:if="{{content && !content.configured && section !== 'core' && section !== 'contacts' && section !== 'points'}}" class="empty">组织方尚未发布本栏目。</view>
    <block wx:if="{{section === 'redemption'}}">
      <view wx:if="{{member && identityReady}}" class="points-card"><view><text class="points-number">{{member.growthPoints}}</text><text class="muted">成长积分</text></view><view><text class="points-number">{{member.annualPoints}}</text><text class="muted">年度积分</text></view><button class="text-button" bindtap="points">查看明细 ›</button></view>
      <view class="notice muted">兑换条件由组织方确认。当前咨询不会扣减积分，也不代表已兑换或已预留物品。</view>
      <view wx:for="{{content.offers}}" wx:key="id" class="offer-card"><text class="card-title">{{item.name}}</text><text class="body">{{item.description}}</text><button class="btn ghost secondary {{selectedOffer === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="selectOffer" disabled="{{busy || formLocked}}">{{selectedOffer === item.id ? '已选此项目' : '咨询这个项目'}}</button></view><view wx:if="{{!content || !content.offers.length}}" class="empty-small">暂无公开兑换项目，可以向组织方咨询后续安排。</view>
    </block>
    <block wx:if="{{section === 'business' || section === 'redemption'}}">
      <view wx:if="{{member && identityReady}}" class="form-card"><text class="card-title">{{section === 'business' ? '留下合作意向' : '向组织方咨询'}}</text><text class="help">联系办法和本次内容仅交给有权限的组织方处理。每条咨询保留处理与撤回记录。</text><view wx:if="{{formLocked}}" class="notice muted">这次提交结果尚未确认。内容暂时锁定，重试会核对同一条请求，请勿另建重复咨询。</view><label class="field"><text>联系办法</text><input value="{{inquiryContact}}" maxlength="100" placeholder="微信或电话，供组织方回复" placeholder-class="placeholder" bindinput="inquiryContact" disabled="{{busy || formLocked}}" /></label><label class="field"><text>{{section === 'business' ? '合作方向' : '希望了解的内容'}}</text><textarea value="{{inquiryMessage}}" maxlength="1000" placeholder="说明具体想法或问题" placeholder-class="placeholder" bindinput="inquiryMessage" disabled="{{busy || formLocked}}" auto-height="{{true}}" /></label><checkbox-group bindchange="inquiryConsent"><label class="check-line"><checkbox value="accepted" checked="{{inquiryConsent}}" color="#ff6b00" /><text>同意将本次咨询及所留联系方式交给组织方处理。</text></label></checkbox-group><button class="btn primary" bindtap="submitInquiry" disabled="{{busy}}" loading="{{busy}}">{{formLocked ? '重试确认提交结果' : '提交咨询'}}</button></view>
      <view wx:else class="empty"><text>登录后可以提交咨询并查看处理记录。</text><button class="btn ghost secondary" bindtap="profile">前往“我的”登录</button></view>
    </block>
<button wx:if="{{canManageContent && identityReady}}" class="btn ghost v2-extra" bindtap="manage">编辑本栏目与处理咨询</button></block><view class="v2-extra"><picker wx:if="{{!embedded || mode === 'manage'}}" range="{{sectionLabels}}" value="{{sectionIndex}}" bindchange="selectSection" disabled="{{busy || loading}}"><view class="section-picker">{{sectionLabels[sectionIndex]}} · 切换栏目 ›</view></picker>  <block wx:if="{{mode === 'manage' && canManageContent && identityReady && content}}">
    <view class="editor-status"><text>{{content.status === 'published' ? '当前已公开' : '当前未公开'}} · 版本 {{content.revision}}</text><text>{{editorDirty ? '有未保存的修改' : '表单与已保存内容一致'}}</text></view>
    <view class="form-card"><text class="card-title">栏目信息</text><label class="field"><text>标题</text><input value="{{draft.title}}" maxlength="60" data-field="title" bindinput="field" disabled="{{busy}}" /></label><label class="field"><text>介绍（可选）</text><textarea value="{{draft.introduction}}" maxlength="400" data-field="introduction" bindinput="field" disabled="{{busy}}" auto-height="{{true}}" /></label></view>
    <view class="section-heading"><text>说明段落</text><text class="muted">{{draft.blocks.length}} / 8</text></view>
    <view wx:for="{{draft.blocks}}" wx:key="index" class="form-card"><view class="row-between"><text class="card-title">段落 {{index + 1}}</text><button class="remove-button" data-group="blocks" data-index="{{index}}" bindtap="removeItem" disabled="{{busy}}">移除</button></view><label class="field"><text>小标题</text><input value="{{item.heading}}" maxlength="50" data-index="{{index}}" data-field="heading" bindinput="blockField" disabled="{{busy}}" /></label><label class="field"><text>内容</text><textarea value="{{item.body}}" maxlength="600" data-index="{{index}}" data-field="body" bindinput="blockField" disabled="{{busy}}" auto-height="{{true}}" /></label></view><button wx:if="{{draft.blocks.length !== 8}}" class="btn ghost secondary" bindtap="addBlock" disabled="{{busy}}">＋ 添加说明段落</button>

    <block wx:if="{{section === 'core'}}"><view class="section-heading"><text>公开核心职责</text><text class="muted">{{draft.people.length}} / 8</text></view><text class="help">只填写已取得公开授权的称呼、职责和介绍。这里的职责不授予后台权限。</text><view wx:for="{{draft.people}}" wx:key="index" wx:for-item="person" wx:for-index="personIndex" class="form-card"><view class="row-between"><text class="card-title">成员 {{personIndex + 1}}</text><button class="remove-button" data-group="people" data-index="{{personIndex}}" bindtap="removeItem" disabled="{{busy}}">移除</button></view><label class="field"><text>公开称呼</text><input value="{{person.name}}" maxlength="30" data-index="{{personIndex}}" data-field="name" bindinput="personField" disabled="{{busy}}" /></label><label class="field"><text>职责称谓</text><input value="{{person.duty}}" maxlength="40" data-index="{{personIndex}}" data-field="duty" bindinput="personField" disabled="{{busy}}" /></label><label class="field"><text>介绍（可选）</text><textarea value="{{person.introduction}}" maxlength="200" data-index="{{personIndex}}" data-field="introduction" bindinput="personField" disabled="{{busy}}" auto-height="{{true}}" /></label><label class="field"><text>头像文字（可选）</text><input value="{{person.avatarText}}" maxlength="4" data-index="{{personIndex}}" data-field="avatarText" bindinput="personField" disabled="{{busy}}"/></label><label class="field"><text>经历说明（可选）</text><input value="{{person.experience}}" maxlength="400" data-index="{{personIndex}}" data-field="experience" bindinput="personField" disabled="{{busy}}"/></label><label class="field"><text>累计里程km（可选）</text><input value="{{person.distanceKm}}" maxlength="12" data-index="{{personIndex}}" data-field="distanceKm" bindinput="personField" disabled="{{busy}}" type="number"/></label><label class="field"><text>服务记录（可选）</text><input value="{{person.serviceText}}" maxlength="100" data-index="{{personIndex}}" data-field="serviceText" bindinput="personField" disabled="{{busy}}"/></label><view wx:for="{{person.responsibilities}}" wx:key="index" wx:for-item="responsibility" wx:for-index="responsibilityIndex" class="responsibility-editor"><input value="{{responsibility}}" maxlength="150" placeholder="具体负责的事项" data-index="{{personIndex}}" data-responsibility="{{responsibilityIndex}}" bindinput="responsibilityField" disabled="{{busy}}" /><button class="remove-button" data-group="responsibility" data-index="{{personIndex}}" data-responsibility="{{responsibilityIndex}}" bindtap="removeItem" disabled="{{busy}}">移除</button></view><button wx:if="{{person.responsibilities.length !== 6}}" class="text-button" data-index="{{personIndex}}" bindtap="addResponsibility" disabled="{{busy}}">＋ 添加职责事项</button></view><button wx:if="{{draft.people.length !== 8}}" class="btn ghost secondary" bindtap="addPerson" disabled="{{busy}}">＋ 添加核心成员</button></block>

    <block wx:if="{{section === 'contacts'}}"><view class="section-heading"><text>补充联系办法</text><text class="muted">{{draft.contacts.length}} / 10</text></view><view class="notice muted">主要联系办法单独保存在成员管理中。这里编辑栏目补充信息，不会自动修改主要联系入口。<button class="text-button" bindtap="primarySettings">管理主要联系办法 ›</button></view><view wx:for="{{draft.contacts}}" wx:key="index" class="form-card"><view class="row-between"><text class="card-title">联系信息 {{index + 1}}</text><button class="remove-button" data-group="contacts" data-index="{{index}}" bindtap="removeItem" disabled="{{busy}}">移除</button></view><label class="field"><text>联系类别</text><input value="{{item.label}}" maxlength="40" placeholder="例如：活动联络" data-index="{{index}}" data-field="label" bindinput="contactField" disabled="{{busy}}" /></label><label class="field"><text>联系人（可选）</text><input value="{{item.name}}" maxlength="30" data-index="{{index}}" data-field="name" bindinput="contactField" disabled="{{busy}}" /></label><view class="field"><text>联系办法</text><picker range="{{methodLabels}}" value="{{item.method === 'phone' ? 0 : item.method === 'wechat' ? 1 : 2}}" data-index="{{index}}" bindchange="contactMethod" disabled="{{busy}}"><view class="picker-value">{{item.method === 'phone' ? '电话' : item.method === 'wechat' ? '微信' : '地址'}} ›</view></picker></view><label class="field"><text>具体信息</text><input value="{{item.value}}" maxlength="200" data-index="{{index}}" data-field="value" bindinput="contactField" disabled="{{busy}}" /></label><label class="field"><text>联系时间（可选）</text><input value="{{item.hours}}" maxlength="80" data-index="{{index}}" data-field="hours" bindinput="contactField" disabled="{{busy}}" /></label><label class="field"><text>补充说明（可选）</text><textarea value="{{item.note}}" maxlength="200" data-index="{{index}}" data-field="note" bindinput="contactField" disabled="{{busy}}" auto-height="{{true}}" /></label></view><button wx:if="{{draft.contacts.length !== 10}}" class="btn ghost secondary" bindtap="addContact" disabled="{{busy}}">＋ 添加联系信息</button></block>

    <block wx:if="{{section === 'redemption'}}"><view class="section-heading"><text>可咨询项目</text><text class="muted">{{draft.offers.length}} / 12</text></view><text class="help">不设置自动扣分或兑现承诺。填写可核实的项目说明，具体办法确认后再发布。</text><view wx:for="{{draft.offers}}" wx:key="id" class="form-card"><view class="row-between"><text class="card-title">项目 {{index + 1}}</text><button class="remove-button" data-group="offers" data-index="{{index}}" bindtap="removeItem" disabled="{{busy}}">移除</button></view><label class="field"><text>项目名称</text><input value="{{item.name}}" maxlength="60" data-index="{{index}}" data-field="name" bindinput="offerField" disabled="{{busy}}" /></label><label class="field"><text>项目说明</text><textarea value="{{item.description}}" maxlength="300" data-index="{{index}}" data-field="description" bindinput="offerField" disabled="{{busy}}" auto-height="{{true}}" /></label></view><button wx:if="{{draft.offers.length !== 12}}" class="btn ghost secondary" bindtap="addOffer" disabled="{{busy}}">＋ 添加咨询项目</button></block>

    <view class="form-card publish-panel"><checkbox-group bindchange="publishRights"><label class="check-line"><checkbox value="accepted" checked="{{rights}}" color="#ff6b00" /><text>确认发布信息已核实，且已取得涉及称呼、联系方式及内容的公开授权。</text></label></checkbox-group><button class="btn ghost secondary" bindtap="saveDraft" disabled="{{busy}}">保存为未公开草稿</button><button class="btn primary" bindtap="publish" disabled="{{busy}}" loading="{{busy}}">公开发布本栏目</button><button class="text-button" bindtap="publicView" disabled="{{busy}}">查看车友看到的页面 ›</button></view>
  </block>

  <view wx:if="{{member && identityReady && ((mode === 'manage' && isOwner) || (mode !== 'manage' && (section === 'business' || section === 'redemption')))}}" class="inquiries"><view class="section-heading"><text>{{mode === 'manage' ? '成员咨询' : '我的咨询记录'}}</text><button class="text-button" bindtap="refreshInquiries" disabled="{{busy || inquiryLoading}}">刷新</button></view><view wx:if="{{inquiryLoading}}" class="loading">正在加载记录…</view><view wx:if="{{!inquiryLoading && !shownInquiries.length}}" class="empty-small">暂无咨询记录。</view><view wx:for="{{shownInquiries}}" wx:key="id" class="inquiry-card"><view class="row-between"><text class="contact-label">{{item.kind === 'business' ? '商务合作' : '兑换咨询'}}</text><text class="inquiry-state">{{item.state === 'open' ? '待处理' : item.state === 'closed' ? '已回复' : '已撤回'}}</text></view><text wx:if="{{mode === 'manage'}}" class="card-title">{{item.nickname}}</text><text wx:if="{{item.offerName}}" class="body">咨询项目：{{item.offerName}}</text><text class="body">{{item.message}}</text><text class="muted">联系办法：{{item.contact}}</text><text class="time">{{item.createdAt}}</text><view wx:if="{{item.reply}}" class="reply"><text class="contact-label">组织方回复</text><text>{{item.reply}}</text></view><button wx:if="{{mode === 'view' && item.state === 'open'}}" class="text-button" data-id="{{item.id}}" bindtap="withdrawInquiry" disabled="{{busy}}">撤回咨询</button><block wx:if="{{mode === 'manage' && item.state === 'open'}}"><textarea class="reply-input" value="{{replies[item.id]}}" maxlength="500" placeholder="记录处理说明，将对这位成员可见" placeholder-class="placeholder" data-id="{{item.id}}" bindinput="inquiryReply" disabled="{{busy}}" auto-height="{{true}}" /><button class="btn ghost secondary" data-id="{{item.id}}" bindtap="reviewInquiry" disabled="{{busy}}">保存回复并完成处理</button></block></view><button wx:if="{{nextCursor}}" class="btn ghost secondary" bindtap="moreInquiries" disabled="{{busy || inquiryLoading}}">继续查看记录</button></view>
  <text class="footer">ORIGINAL RALLY · 原始拉力</text>
</view></view></view></view>