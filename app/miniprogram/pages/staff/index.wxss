.ops-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.ops-task{display:flex;flex-direction:column;align-items:flex-start;gap:9rpx;text-align:left;background:#201a15;border:1rpx solid #50331d;padding:24rpx;font-size:25rpx}.ops-task .tiny{font-size:20rpx;font-weight:400;color:#b9a695}.ops-alert{background:#2b2015;border-color:#67431e;color:#f5be77}.ops-number{font-size:48rpx;font-weight:650;line-height:1.2}.ops-unreturned{border-left:6rpx solid #ff8a3d}.ops-safety{color:#f5be77;font-weight:550}
.ops-create-bar{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:28rpx;margin:24rpx 0;background:#231c17;border:1rpx solid #624025;border-radius:18rpx}.ops-create-bar .primary{flex-shrink:0;font-size:25rpx;padding:0 24rpx;margin:0}.ops-activity-card{border-left:4rpx solid #634326}.ops-activity-card .text-button{margin:0;padding:0;font-size:24rpx}.ops-editor{border:1rpx solid #a75a29;padding:30rpx}.ops-editor-heading{display:flex;justify-content:space-between;align-items:center;gap:18rpx}.ops-editor-heading .eyebrow{margin-bottom:12rpx}.ops-frozen-summary{padding:24rpx;margin-top:24rpx;background:#1a1714;border-radius:12rpx}.staff-page .form-grid{min-width:0}.staff-page .form-grid>view{min-width:0}
