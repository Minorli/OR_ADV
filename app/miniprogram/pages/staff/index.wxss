.ops-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.ops-task{display:flex;flex-direction:column;align-items:flex-start;gap:9rpx;text-align:left;background:#f2f5ec;border:1rpx solid #e2e8d9;padding:24rpx;font-size:25rpx}.ops-task .tiny{font-size:20rpx;font-weight:400;color:#7a8572}.ops-alert{background:#f8f3e9;border-color:#eadfc9;color:#8a623c}.ops-number{font-size:48rpx;font-weight:650;line-height:1.2}.ops-unreturned{border-left:6rpx solid #a77942}.ops-safety{color:#8a623c;font-weight:550}
