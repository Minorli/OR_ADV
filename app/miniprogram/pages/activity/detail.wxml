<view wx:if="{{isMock}}" class="demo">本机演示 · 人物与活动均为虚构</view>
<view class="ride-detail">
  <view wx:if="{{loading}}" class="loading">正在获取活动规则…</view>
  <view wx:if="{{error}}" class="detail-error notice error">{{error}}<button class="text-button" bindtap="retry">重新加载</button></view>
  <block wx:if="{{activity}}">
    <view class="detail-cover cover-fallback"><image wx:if="{{!coverFailed}}" class="detail-photo" src="{{activity.cover}}" mode="aspectFill" binderror="coverError"/><view class="detail-photo-shade"></view><view class="detail-cover-top"><text class="detail-cover-brand">OR / ORIGINAL RALLY</text><text class="detail-cover-note">示意封面</text></view><view class="detail-cover-copy"><view class="detail-cover-tags"><text class="detail-state {{activity.statusTone}}">{{activity.stateText}}</text><text class="detail-duration">{{activity.durationText}}</text></view><view class="detail-title">{{activity.title}}</view></view></view>
    <view class="detail-content">
      <view class="detail-summary"><view class="summary-cell"><text class="summary-label">活动强度</text><text class="summary-value">{{activity.difficulty}}</text><view class="detail-level"><view wx:for="{{activity.difficultyBars}}" wx:key="id" class="level-bar {{item.active ? 'on' : ''}}"></view></view></view><view class="summary-cell"><text class="summary-label">本场名额</text><text class="summary-value">{{activity.capacity}}<text class="summary-unit">位</text></text><text class="summary-note">{{activity.slots > 0 ? '余位 ' + activity.slots : '名额已满'}}</text></view><view class="summary-cell"><text class="summary-label">成长门槛</text><text class="summary-value orange">{{activity.minGrowthPoints}}<text class="summary-unit">分</text></text><text class="summary-note">报名不扣积分</text></view></view>
      <view wx:if="{{registration}}" class="detail-registration"><view class="registration-heading"><text>我的参加状态</text><text class="orange">{{registration.stateText}}</text></view><view class="registration-copy">{{nextAction}}</view><button class="registration-link" bindtap="mine">查看本场进展 →</button></view>

      <view class="detail-section-head"><view><text class="detail-section-index">01</text><text class="detail-section-title">活动安排</text></view><text class="detail-section-en">THE RIDE</text></view>
      <view class="detail-card"><view class="route-label">活动区域</view><view class="route-location">{{activity.location}}</view><view class="schedule-list"><view class="schedule-row"><text class="schedule-label">计划开始</text><text class="schedule-value">{{activity.dateText}}</text></view><view class="schedule-row"><text class="schedule-label">计划结束</text><text class="schedule-value">{{activity.endText}}</text></view><view class="schedule-row"><text class="schedule-label">申请截止</text><text class="schedule-value">{{activity.deadlineText}}</text></view></view><view class="detail-hint">确认参加后，在“我的活动”查看具体集合安排与准备清单。</view></view>
      <view class="detail-card"><view class="detail-body">{{activity.description}}</view></view>

      <view class="detail-section-head"><view><text class="detail-section-index">02</text><text class="detail-section-title">参加条件</text></view><text class="detail-section-en">BE READY</text></view>
      <view class="detail-card"><view class="requirement-row"><view><view class="requirement-label">成长积分</view><view class="requirement-copy">以已结算的有效记录为准</view></view><view class="requirement-points">{{activity.minGrowthPoints}}<text>分起</text></view></view><view wx:if="{{gap > 0}}" class="condition-note">{{member ? '当前成长积分还差 ' + gap + ' 分。' : '登录后可以核对自己的成长记录。'}}先从适合自己的入门活动开始。</view><view wx:else class="detail-hint">积分达到门槛，仍需满足本场技能、车况及现场安全条件。</view><view class="requirements-divider"></view><view class="requirement-label">必要资格</view><view wx:if="{{!activity.qualificationLabels.length}}" class="requirement-copy">本场无额外资格要求。</view><view wx:for="{{activity.qualificationLabels}}" wx:key="*this" class="qualification-item"><text class="qualification-mark">·</text>{{item}}</view><view class="detail-hint">{{activity.requiresReview ? '本场需要工作人员核对必要资格，确认后方可参加。' : '请如实评估自身能力，按本场要求准备。'}}</view></view>
      <view class="detail-card"><view class="equipment-heading"><text class="detail-small-index">A</text><text class="requirement-label">必要装备</text></view><view class="detail-body equipment-copy">{{activity.equipment}}</view></view>
      <view class="detail-card safety-card"><view class="equipment-heading"><text class="detail-small-index">!</text><text class="requirement-label">风险与安全</text></view><view class="detail-body equipment-copy">{{activity.safetyNotice}}</view><view class="safety-footnote">非铺装摩托车活动存在风险，请依据个人能力与车况决定。成员身份与积分都不替代现场安全判断；食宿交通由参加者自行安排。</view></view>

      <view class="detail-section-head"><view><text class="detail-section-index">03</text><text class="detail-section-title">完成记录</text></view><text class="detail-section-en">EVERY RIDE COUNTS</text></view>
      <view class="detail-card points-card"><view class="points-grid"><view class="points-cell"><view class="points-number">+{{activity.pointsRule.growth}}</view><view class="points-caption">成长积分</view></view><view class="points-cell"><view class="points-number">+{{activity.pointsRule.annual}}</view><view class="points-caption">年度积分</view></view><view class="points-cell"><view class="points-number">+1</view><view class="points-caption">完成次数</view></view></view><view class="detail-hint points-rule">完整出发核验、结束核验并经结算后记录。候补、报名、未到及安全退出不直接获得完成奖励。本场规则 v{{activity.ruleVersion}}。</view></view>
      <view class="participation-note"><view class="requirement-label">报名与确认</view><view class="requirement-copy">创始成员在资格、规则与名额均满足时，直接确认参加。普通成员提交报名意向后，按页面状态联系工作人员安排线下缴费，由管理员确认。候补不占名额，无需提前安排缴费。</view></view>
      <view class="detail-card detail-contact"><view class="contact-heading"><view class="requirement-label">联系组织方</view><text class="contact-label">CONTACT</text></view><view wx:if="{{contact.configured}}" class="contact-person">{{contact.contactName}}</view><view wx:if="{{contact.configured}}" class="contact-value">{{contact.contactValue}}</view><view wx:if="{{contact.configured}}" class="requirement-copy">{{contact.contactInstructions}}</view><button wx:if="{{contact.configured}}" class="secondary full contact-button" bindtap="contact">{{contact.contactMethod === 'phone' ? '联系工作人员' : '复制联系信息'}} ↗</button><view wx:else class="requirement-copy">组织方尚未提供有效联系办法。</view></view>
      <view class="detail-footer">ORIGINAL RALLY · 准备充分，平安同行</view>
    </view>
    <view class="detail-action-bar"><view class="action-context"><view class="action-label">{{registration ? '我的活动' : activity.canApply ? '本场名额' : '当前状态'}}</view><view class="action-value">{{registration ? registration.stateText : activity.canApply ? activity.slots > 0 ? '余 ' + activity.slots + ' 位' : '名额已满' : activity.stateText}}</view></view><button wx:if="{{registration}}" class="detail-main-button" bindtap="mine">查看我的活动 →</button><button wx:elif="{{activity.canApply}}" class="detail-main-button" disabled="{{member && gap > 0}}" bindtap="apply">{{member && gap > 0 ? '成长积分暂未达标' : activity.slots > 0 ? member && member.memberKind === 'founder' ? '阅读规则并参加' : '提交报名意向' : '提交候补意向'}} →</button><button wx:else class="detail-main-button unavailable" disabled>当前{{activity.stateText}}</button></view>
  </block>
</view>
