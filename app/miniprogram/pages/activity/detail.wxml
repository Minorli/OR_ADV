<view class="page reference-v2 activity-leaf {{embedded ? 'is-embedded' : ''}}">
  <view class="v2-sheet-content">
    <view class="grip"></view><view class="shd"><text class="h3">{{activity ? activity.title : '活动详情'}}</text><button class="x" bindtap="referenceClose" aria-label="关闭活动详情">✕</button></view>
    <view class="bdy act-detail">
      <view wx:if="{{loading}}" class="loading">正在加载活动…</view><view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重试</button></view>
      <block wx:if="{{activity}}">
        <view class="cover"><image wx:if="{{!coverFailed}}" class="cover-image" src="{{activity.cover}}" mode="aspectFill" binderror="coverError"/><view class="cover-shade"></view><text class="nm">{{activity.title}}</text></view>
        <view class="muted">{{activity.dateText}} · {{activity.location}}</view><view class="activity-tags"><text class="ptag">{{activity.distanceText}}</text><text class="ptag">{{activity.difficulty}}</text><text class="ptag">{{activity.durationText}}</text></view>
        <text class="p activity-description">{{activity.description}}</text>
        <view class="divider"></view><text class="h3 section-title">报名要求</text>
        <view class="requirement">成长积分 ≥ {{activity.minGrowthPoints}}</view><view wx:for="{{activity.qualificationLabels}}" wx:key="*this" class="requirement">{{item}}</view><view wx:if="{{!activity.qualificationLabels.length}}" class="requirement">本场无额外技能资格要求</view>
        <view wx:if="{{gap > 0}}" class="warn-box r"><view class="tx"><text class="h4">{{member ? '成长积分还差 ' + gap + ' 分' : '登录后核对本人资格'}}</text><text class="p">先从适合自己的活动开始。技能与现场安全条件仍需分别核对。</text></view></view>
        <view class="divider"></view><text class="h3 section-title">路线分段</text>
        <view wx:for="{{activity.itinerary}}" wx:key="index" class="stage"><text class="b">{{item.dayLabel}} · {{item.title}}</text><text class="span">{{item.description}}</text></view><view wx:if="{{!activity.itinerary.length}}" class="muted">路线分段由组织方确认后公布。</view>
        <view class="divider"></view><text class="h3 section-title">报名与费用安排</text><view class="price-box"><view class="price-line">创始合伙人在资格、规则与名额均满足时直接确认参加。</view><view class="price-line">普通成员提交意向后，联系工作人员安排线下缴费，由管理员确认。候补不占名额，无需提前缴费。</view><view class="price-line muted">食宿和交通由参加者自行安排。</view></view>
        <view class="divider"></view><view class="warn-box"><text class="ic">!</text><view class="tx"><text class="h4">出发前请核对</text><text class="p">{{activity.safetyNotice}}</text></view></view>
        <view wx:if="{{registration}}" class="result-box show w"><text class="b">{{registration.stateText}}</text><text class="p">{{nextAction}}</text><button class="text-button" bindtap="mine">查看本场进展 ›</button></view>
        <button wx:if="{{registration}}" class="btn primary mt" bindtap="mine">查看我的活动</button><button wx:elif="{{activity.canApply}}" class="btn primary mt" disabled="{{member && gap > 0}}" bindtap="apply">{{member && gap > 0 ? '成长积分暂未达标' : activity.slots > 0 ? '阅读规则并报名' : '申请候补'}}</button><button wx:else class="btn primary mt" disabled>当前{{activity.stateText}}</button>
        <view class="v2-extra"><view class="sec-t"><text class="b">本场准备</text></view><view class="info-row"><view class="lb"><text class="b">必要装备</text><text class="span">{{activity.equipment}}</text></view></view><view class="info-row"><view class="lb"><text class="b">时间与名额</text><text class="span">结束 {{activity.endText}} · 截止 {{activity.deadlineText}}</text><text class="span">{{activity.seatText}} · {{activity.requiresReview ? '需核对资格后确认' : '请按本场要求准备'}}</text></view></view><view class="info-row"><view class="lb"><text class="b">完成记录</text><text class="span">成长 +{{activity.pointsRule.growth}} · 年度 +{{activity.pointsRule.annual}} · 兑换 +{{activity.pointsRule.redeemable || 0}}</text><text class="span">完成出发、结束核验并结算后记录，报名不直接获得奖励。</text></view></view><view wx:if="{{contact.configured}}" class="ct-line"><view class="tx"><text class="b">{{contact.contactName}}</text><text class="span">{{contact.contactInstructions}}</text><button class="text-button" bindtap="contact">{{contact.contactMethod === 'phone' ? '联系工作人员' : '复制联系信息'}} ›</button></view></view></view>
      </block>
    </view>
  </view>
</view>
