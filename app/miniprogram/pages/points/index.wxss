.points-heading{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.points-heading .eyebrow{font-size:18rpx;letter-spacing:3rpx}.points-heading .text-button{flex-shrink:0}
.wallet-card{border:1rpx solid #68431f;border-radius:24rpx;background:linear-gradient(140deg,#332314,#1b1712 75%);padding:30rpx;margin-top:30rpx;overflow:hidden}.wallet-top{display:flex;align-items:center;justify-content:space-between;gap:16rpx;color:#e4c1a0;font-size:25rpx}.wallet-status{color:#a99580;font-size:19rpx;text-align:right}.wallet-amount{font-size:86rpx;line-height:1.2;letter-spacing:-3rpx;color:#ff953f;font-weight:700;margin:27rpx 0}.wallet-amount>text{font-size:24rpx;letter-spacing:0;margin-left:13rpx;color:#cbb49b}.wallet-breakdown{display:flex;gap:45rpx;color:#ab9985;font-size:21rpx}.wallet-breakdown>view{display:flex;flex-direction:column;gap:5rpx}.wallet-detail-number{font-size:30rpx;color:#e9d7c4}.wallet-action{display:flex;align-items:center;justify-content:space-between;width:100%;padding:24rpx 0 0;margin-top:28rpx;border-top:1rpx solid #513b25;border-radius:0;background:transparent;color:#ffb272;font-size:26rpx}.wallet-action::after{display:none;border:0}
.points-explanation{color:#a19589;font-size:22rpx;line-height:1.85;margin-top:22rpx}.points-page .stats{padding:26rpx 10rpx}.points-page .stat{min-width:0}.points-page .stat-number{font-size:38rpx}.points-page .stat-label{font-size:21rpx}.points-empty{padding:35rpx 18rpx;font-size:23rpx}.points-policy{background:#171717;border:1rpx solid #303030;border-radius:14rpx;padding:22rpx;color:#b7ada2;font-size:23rpx;line-height:1.8;margin-bottom:22rpx}.wallet-ledger{padding:27rpx 0;border-bottom:1rpx solid #292929}.wallet-ledger .card-title{font-size:26rpx}.wallet-ledger .mt{margin-top:12rpx}.wallet-delta{font-size:32rpx;font-weight:600;color:#ff9b54;white-space:nowrap}.wallet-delta>text{font-size:18rpx;font-weight:400;color:#a9a9a9;margin-left:8rpx}.wallet-delta.negative{color:#d4ad96}
