.profile-card-person{display:flex;align-items:center;gap:22rpx;margin-top:32rpx}.profile-card-person .member-name{margin-top:0}.profile-card-avatar{width:88rpx;height:88rpx;flex-shrink:0;border-radius:50%;background:#48674f}.profile-avatar-default{display:flex;align-items:center;justify-content:center;font-size:29rpx;font-weight:750;font-style:italic;letter-spacing:-2rpx;color:#dbe8c9}.profile-avatar-editor{display:flex;align-items:center;gap:26rpx}.profile-avatar-choice{width:128rpx;height:128rpx;padding:0;border-radius:50%;flex-shrink:0;background:#e9eedc}.profile-edit-avatar{display:block;width:128rpx;height:128rpx;border-radius:50%}.profile-edit-avatar.profile-avatar-default{display:flex;font-size:38rpx;color:#527044}.profile-avatar-editor .small{margin-top:10rpx}
