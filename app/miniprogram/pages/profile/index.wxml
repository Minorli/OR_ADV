<view class="page reference-v2 profile-reference profile-page" style="padding-top:{{v2Chrome.top}}px">
  <view class="topbar" style="top:{{v2Chrome.top}}px;padding-right:{{v2Chrome.right}}px"><text class="h1">我的</text><view class="tb-actions"><text class="tag o">{{member && identityVerified ? adminTitle || kindLabel : '车友'}}</text></view></view>
  <view class="reference-profile-body">
    <view wx:if="{{loading || (!identityVerified && member)}}" class="loading">正在加载个人资料…</view>
    <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重试</button></view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <view wx:if="{{logoutError}}" class="notice error">{{logoutError}}<button class="text-button" bindtap="retryLogout">重试保存退出设置</button></view>
    <view wx:if="{{identityVerified || !member}}" class="profile">
      <view class="av profile-avatar-frame">
        <button wx:if="{{member}}" class="profile-hero-avatar-button" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" binderror="avatarChoiceFailed" disabled="{{saving || avatarProcessing}}"><image wx:if="{{avatarUrl}}" class="profile-hero-avatar" src="{{avatarUrl}}" mode="aspectFill" data-scope="saved" data-src="{{avatarUrl}}" binderror="avatarFailed"/><view wx:else class="profile-hero-avatar profile-avatar-default">{{nicknameInitial}}</view></button>
        <view wx:else class="profile-hero-avatar profile-avatar-default">OR</view><text class="badge i profile-or-badge">OR</text>
      </view>
      <view class="nm">{{member ? member.nickname : '原始拉力车友'}}</view>
      <button wx:if="{{member}}" class="id reference-profile-number" bindtap="copyMemberNumber" disabled="{{memberNumber === '待分配'}}">No.{{memberNumber}} · {{adminTitle || kindLabel}}</button>
      <view wx:else class="id" bindtap="edit">用微信登录，留下你的同行记录 ›</view>
      <view class="tags"><text wx:if="{{member && joinedDays !== null}}" class="tag o">已加入 {{joinedDays}} 天</text><text wx:if="{{member && dossierApproved}}" class="tag gn">骑手资料已核对</text><text wx:if="{{member && kindExpiresText}}" class="tag">身份有效至 {{kindExpiresText}}</text><text wx:if="{{!member}}" class="tag o" bindtap="edit">登录 / 设置个人资料</text></view>
    </view>

    <view wx:if="{{member && identityVerified}}" class="verify-card" bindtap="dossier">
      <view class="vc-hd"><view class="vc-lf"><text class="b">{{dossierStatus}} · {{dossierPercent}}%</text><text class="span">{{dossierError || dossierNote}}</text></view><text class="vc-st {{dossierApproved ? 'gn' : 'r'}}">{{dossierBadge}}</text></view>
      <view class="vc-bar"><view class="i" style="width:{{dossierPercent}}%"></view></view><view class="vc-tags"><text class="vc-t" aria-label="驾驶证资料尚未启用收集">驾驶证</text><text wx:for="{{dossierParts}}" wx:key="name" class="vc-t {{item.ready ? 'on' : ''}}">{{item.name}}</text></view>
    </view>
    <view wx:if="{{member && identityVerified}}" class="stats"><view class="st" bindtap="points"><text class="b">{{member.growthPoints}}</text><text class="span">积分</text></view><view class="st" bindtap="ranking"><text class="b">{{statistics && statistics.rank !== null ? statistics.rank : '—'}}</text><text class="span">排名</text></view><view class="st"><text class="b">{{statistics && statistics.distanceKm !== null ? statistics.distanceKm : '—'}}</text><text class="span">累计里程</text></view><view class="st" bindtap="trips"><text class="b">{{member.completedCount}}</text><text class="span">参加活动</text></view></view>
    <view wx:if="{{member && identityVerified && statisticsError}}" class="reference-statistics-error">{{statisticsError}}</view>

    <view class="card-h reference-assessment-heading"><text class="h3">考核中心</text><text class="muted">练习与审核记录</text></view>
    <view class="grid">
      <button class="gi" bindtap="safety"><image class="i" src="/assets/icons/v2-shield.png" mode="aspectFit"/><text class="span">安全穿越考核</text></button>
      <button class="gi" bindtap="basicSkills"><image class="i" src="/assets/icons/v2-video.png" mode="aspectFit"/><text class="span">基础控车考核</text></button>
      <button class="gi" bindtap="advancedSkills"><image class="i" src="/assets/icons/v2-flag.png" mode="aspectFit"/><text class="span">进阶控车考核</text></button>
      <button class="gi" bindtap="practice"><image class="i" src="/assets/icons/v2-clock.png" mode="aspectFit"/><text class="span">日常练车报名</text></button>
      <button class="gi" bindtap="redemption"><image class="i" src="/assets/icons/v2-gift.png" mode="aspectFit"/><text class="span">积分兑换</text></button>
      <button class="gi" bindtap="handbook"><image class="i" src="/assets/icons/v2-doc.png" mode="aspectFit"/><text class="span">车队手册</text></button>
    </view>
    <view class="list-menu">
      <view class="li" bindtap="core"><image class="ic" src="/assets/icons/v2-shield.png" mode="aspectFit"/><view class="tx"><text class="b">车队核心成员</text><text class="span">领队 / 技师 / 运营 / 商务</text></view><text class="ar">›</text></view>
      <view class="li" bindtap="handbook"><image class="ic" src="/assets/icons/v2-doc.png" mode="aspectFit"/><view class="tx"><text class="b">OR车队手册</text><text class="span">车队公约 / 费用制度 / 应急预案</text></view><text class="ar">›</text></view>
      <view class="li" bindtap="rules"><image class="ic" src="/assets/icons/v2-arrows.png" mode="aspectFit"/><view class="tx"><text class="b">积分规则</text><text class="span">获取 · 用途 · 记录核对</text></view><text class="ar">›</text></view>
      <view class="li" bindtap="contacts"><image class="ic" src="/assets/icons/v2-mail.png" mode="aspectFit"/><view class="tx"><text class="b">联系我们</text><text class="span">随队保障 · 组织方 · 救援联系</text></view><text class="ar">›</text></view>
      <view class="li" bindtap="business"><image class="ic" src="/assets/icons/v2-cube.png" mode="aspectFit"/><view class="tx"><text class="b">商务合作</text><text class="span">品牌赞助 · 联名活动 · 装备测试</text></view><text class="ar">›</text></view>
    </view>
    <view class="logout"><button wx:if="{{member && identityVerified}}" class="a" bindtap="logout">退出登录</button><button wx:elif="{{!member}}" class="a" bindtap="edit">用微信登录</button><view class="reference-profile-version">OriginalRally · ADV 探险拉力俱乐部</view></view>

    <view wx:if="{{member && identityVerified}}" class="profile-menu reference-extra-menu"><view class="profile-menu-row" bindtap="trips"><view><view class="profile-menu-title">我的同行</view><view class="profile-menu-caption">报名进度、集合准备与完成记录</view></view><text class="profile-menu-arrow">›</text></view><view class="profile-menu-row" bindtap="points"><view><view class="profile-menu-title">积分明细</view><view class="profile-menu-caption">核对积分来源与更正记录</view></view><text class="profile-menu-arrow">›</text></view><view class="profile-menu-row" bindtap="edit"><view><view class="profile-menu-title">头像与昵称</view><view class="profile-menu-caption">选择微信头像，修改自己的称呼</view></view><text class="profile-menu-arrow">›</text></view><view class="profile-menu-row" bindtap="privacySettings"><view><view class="profile-menu-title">隐私设置</view><view class="profile-menu-caption">分别管理公开展示的同意</view></view><text class="profile-menu-arrow">›</text></view><view wx:if="{{staff}}" class="profile-menu-row" bindtap="staff"><view><view class="profile-menu-title">员工工作台</view><view class="profile-menu-caption">活动发布、报名确认与核验结算</view></view><text class="profile-menu-arrow">›</text></view><view wx:if="{{isOwner}}" class="profile-menu-row" bindtap="members"><view><view class="profile-menu-title">成员与身份管理</view><view class="profile-menu-caption">核对成员身份，管理工作权限</view></view><text class="profile-menu-arrow">›</text></view></view>
  <view wx:if="{{identityVerified && avatarError && !showEdit}}" class="notice error">{{avatarError}}<button wx:if="{{member.hasAvatar}}" class="text-button" disabled="{{avatarLoading}}" bindtap="retryAvatar">重试</button></view>
  <view wx:if="{{identityVerified && (!member || showEdit)}}" id="profile-editor" class="card profile-panel">
    <view class="card-title">{{member ? '设置头像与昵称' : isMock ? '建立本地身份' : '用微信登录'}}</view>
    <view wx:if="{{!member}}" class="small muted mt">{{isMock ? '当前使用保存在设备上的虚构人物和活动，不进行微信登录。' : '浏览活动无需登录。登录后，使用微信专属标识关联你的报名与成长记录；头像和昵称均可稍后填写。'}}</view>
    <block wx:if="{{member}}">
      <view class="profile-avatar-editor mt"><button class="profile-avatar-choice" open-type="chooseAvatar" bindchooseavatar="chooseAvatar" binderror="avatarChoiceFailed" disabled="{{saving || avatarProcessing}}"><image wx:if="{{avatarDraftUrl && !draftPreviewFailed}}" class="profile-edit-avatar" src="{{avatarDraftUrl}}" mode="aspectFill" data-scope="draft" data-src="{{avatarDraftUrl}}" binderror="avatarFailed"/><image wx:elif="{{!avatarDraftUrl && avatarUrl}}" class="profile-edit-avatar" src="{{avatarUrl}}" mode="aspectFill" data-scope="saved" data-src="{{avatarUrl}}" binderror="avatarFailed"/><view wx:else class="profile-edit-avatar profile-avatar-default">OR.</view></button><view class="grow"><view class="card-title">{{avatarProcessing ? '正在准备头像…' : '选择微信头像或照片'}}</view><view class="small muted mt">头像只在你自己的资料页显示，不会自动公开。</view></view></view>
      <view wx:if="{{avatarError}}" class="notice error">{{avatarError}}<button wx:if="{{member.hasAvatar}}" class="text-button" disabled="{{avatarLoading}}" bindtap="retryAvatar">重试</button></view>
      <view wx:if="{{avatarBase64}}" class="small muted mt">新头像尚未保存。</view>
      <view class="field"><text class="field-label">昵称（可用微信昵称，也可自己填写）</text><input type="nickname" value="{{nickname}}" maxlength="24" bindinput="nickname" bindblur="nicknameBlur" bindnicknamereview="nicknameReview" placeholder="点击选择微信昵称或填写俱乐部称呼" disabled="{{saving}}"/></view>
      <view class="small muted mb">点击昵称框，可在键盘上方选择微信昵称。头像和昵称均可随时修改，不会自动公开。</view>
      <view wx:if="{{nicknameError}}" class="notice error">{{nicknameError}}</view><view wx:elif="{{nicknameStatus === 'pending'}}" class="small muted mb">填写后请点键盘“完成”，待昵称检测通过再保存。</view>
    </block>
    <checkbox-group wx:if="{{!member}}" bindchange="consent"><label class="check-line"><checkbox value="accepted" checked="{{consent}}" color="#FF6B00"/><text>我已阅读隐私与使用说明，同意使用{{isMock ? '本地身份' : '微信专属身份标识'}}记录报名、核验与成长。无需手机号或定位权限。</text></label></checkbox-group>
    <button wx:if="{{!member}}" class="text-button mb" bindtap="privacy">{{showPrivacy ? '收起隐私说明' : '阅读隐私与使用说明'}}</button>
    <button class="primary full" disabled="{{saving || avatarProcessing || (!member && !consent) || nicknameStatus === 'pending' || nicknameStatus === 'rejected' || nicknameStatus === 'timeout'}}" loading="{{saving}}" bindtap="save">{{member ? '保存个人资料' : isMock ? '同意并建立本地身份' : '同意并用微信登录'}}</button>
    <button wx:if="{{member}}" class="text-button full" disabled="{{saving || avatarProcessing}}" bindtap="edit">稍后再填</button>
  </view>
  <block wx:if="{{member && identityVerified}}"><view class="profile-section-heading"><view class="profile-section-marker"></view><text>公开展示</text></view><view class="card profile-panel"><view class="profile-setting-head"><view class="card-title">俱乐部推荐</view><text class="profile-setting-status {{member.recommendationOptIn ? 'is-public' : ''}}">{{member.recommendationOptIn ? '已公开' : '未公开'}}</text></view><view class="small muted mt">公开昵称与成员身份。推荐顺序和积分名次分开；积分与次数需要另行同意公开。</view><button class="secondary full mt" disabled="{{saving}}" bindtap="recommendation">{{member.recommendationOptIn ? '退出公开推荐' : '了解并同意公开推荐'}}</button><view class="divider"></view><view class="profile-setting-head"><view class="card-title">积分榜</view><text class="profile-setting-status {{member.rankingOptIn ? 'is-public' : ''}}">{{member.rankingOptIn ? '已公开' : '未公开'}}</text></view><view class="small muted mt">按实际记录排序，公开昵称、积分与完成次数。</view><button class="secondary full mt" disabled="{{saving}}" bindtap="rankingConsent">{{member.rankingOptIn ? '退出积分榜' : '了解并加入积分榜'}}</button><view class="profile-panel-note">两项分别生效。退出公开展示不影响成员身份和活动参加。</view></view></block>
  <view wx:if="{{identityVerified && member && member.memberKind !== 'founder'}}" class="card profile-panel"><view class="card-title">核对成员身份</view><view class="small muted mt">既有成员可向主理人申请核对。核定不授予员工权限，也不增加积分或技能资格。</view><view wx:if="{{member.kindRequestStatus === 'pending'}}" class="notice">核对申请待处理，可通过组织方联系办法补充说明。</view><block wx:else><view class="field"><text class="field-label">核对线索（选填）</text><input value="{{kindReason}}" maxlength="300" bindinput="kindReason" placeholder="原使用称呼或其他必要说明"/></view><button class="secondary full" disabled="{{saving}}" bindtap="requestKind">申请核对成员身份</button></block></view>
  <view wx:if="{{canManageContent && identityVerified}}" class="profile-menu"><view wx:if="{{isOwner}}" class="profile-menu-row" bindtap="dossierQueue"><view><view class="profile-menu-title">骑手资料审核</view><view class="profile-menu-caption">核对已提交版本，记录通过或退回原因</view></view><text class="profile-menu-arrow">›</text></view><view class="profile-menu-row" bindtap="clubManagement"><view><view class="profile-menu-title">{{isOwner ? '栏目与咨询管理' : '公开内容管理'}}</view><view class="profile-menu-caption">{{isOwner ? '编辑公开信息，处理商务与兑换咨询' : '维护栏目、活动回顾与知识内容'}}</view></view><text class="profile-menu-arrow">›</text></view></view>
  <view class="profile-section-heading"><view class="profile-section-marker"></view><text>联系组织方</text></view><view class="card profile-panel"><view class="card-title">{{contact.contactName || contact.name}}</view><view wx:if="{{contact.configured}}" class="small muted mt">{{contact.contactInstructions || '活动安排、报名与记录问题，请通过以下方式联系。'}}</view><view wx:if="{{contact.configured}}" class="profile-contact-value">{{contact.contactValue}}</view><button wx:if="{{contact.configured}}" class="secondary full mt" bindtap="contact">{{contact.contactMethod === 'phone' ? '联系工作人员' : '复制联系信息'}}</button><view wx:else class="small muted mt">组织方尚未提供联系办法，活动开放前需先补齐。</view></view>
  <view id="profile-privacy" class="profile-menu profile-privacy-menu"><view class="profile-menu-row" bindtap="privacy"><text class="profile-menu-title">隐私与使用说明</text><text class="profile-menu-arrow">{{showPrivacy ? '−' : '＋'}}</text></view></view>
  <view wx:if="{{showPrivacy}}" class="card privacy-text profile-panel"><view class="card-title mb">个人信息的使用</view><view class="paragraph">1. 公开活动可直接浏览。{{isMock ? '当前使用保存在设备上的虚构身份，不进行微信登录。' : '同意登录后，使用微信专属标识关联昵称、报名、核验、成员身份与成长流水。'}}

2. 头像与昵称均为选填，只有你主动选择头像并保存后才会记录。头像只用于自己的资料页，{{isMock ? '保存在当前设备' : '由本小程序保存'}}，不加入公开推荐或积分榜。选择头像时仅处理你确认的图片，不读取其他相册内容；不主动获取手机号或定位。不要在昵称、核对线索或普通说明中填写敏感资料。

3. 本人查看自己的记录，有授权的工作人员为活动组织、资格核对和结算使用必要资料。成员身份与员工权限分别管理。骑手资料由你主动填写，可包含联系办法、经本人同意提供的紧急联系人、装备和车辆照片；草稿本人可见，提交快照由主理人核对。目前不收集证件号、血型、病史和证照照片。知识练习及技能提交分别保留实际作答和审核记录，商务与兑换咨询仅本人和有权限的组织方查看。

4. 俱乐部推荐与积分榜分别征求同意，默认不公开。活动评价的正文、昵称和荣誉展示分别由你确认，公开前由组织方核对，可撤回评价。组织方发布照片和视频前需确认公开使用权。已经打开的临时图片链接可能在短暂有效期内继续显示。

5. 可以修改昵称、申请核对身份、更正记录或提交注销申请。因安全核验、争议处理或法定义务需要保留的记录，由组织方说明依据与期限。

6. 更正、隐私与注销问题，请通过本页组织方联系办法反馈。</view><view class="notice">参加活动须满足本场资格、装备和安全要求。成员身份与积分都不替代技能或现场核验。</view><button wx:if="{{member && identityVerified}}" class="text-button full profile-delete" disabled="{{saving}}" bindtap="deletion">提交注销申请</button></view>
  <view wx:if="{{isMock}}" class="card profile-panel profile-demo-panel"><view class="profile-setting-head"><view class="card-title">切换身份</view><text class="profile-setting-status">本地</text></view><view class="small muted mt">人物和活动均为虚构，仅保存在当前设备。切换身份可查看不同成员的页面。</view><picker mode="selector" range="{{roles}}" bindchange="role"><view class="picker mt">当前：{{roleLabel}} <text>切换 ›</text></view></picker><button class="secondary full mt" bindtap="reset">重置数据</button><view class="profile-panel-note">恢复初始人物和活动，清除当前设备上的修改。</view></view>
  <view class="footer-note">ORIGINAL RALLY · 原始拉力</view>
  </view>
  <reference-overlay kind="{{refPanel}}" params="{{refParams}}" bindclose="closeReference"/>
</view>
