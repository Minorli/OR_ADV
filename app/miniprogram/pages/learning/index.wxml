<view class="page reference-v2 learning-leaf {{embedded ? 'is-embedded' : ''}}"><view class="v2-modal-content"><view class="bdy">
  <button class="reference-close" bindtap="referenceClose" aria-label="关闭安全知识练习">✕</button><view class="ic-big"><image class="svg" src="/assets/icons/v2-shield.png" mode="aspectFit"/></view><text class="h3">安全穿越考核</text><text class="sub">每次抽取 20 题 · 答案确认后保存 · 依据负责人核定内容练习</text>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry">重试</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}" class="loading">正在加载练习…</view>
  <view wx:if="{{!loading && !member}}" class="empty">登录后继续自己的安全知识练习。<button class="btn primary mt" bindtap="profile">前往登录</button></view>
  <block wx:if="{{member}}">
    <view wx:if="{{!practice}}"><view wx:if="{{catalog.fixtureOnly}}" class="tip on w">当前题目用于熟悉练习流程，活动考核以负责人核定内容为准。</view><view wx:if="{{!catalog.configured}}" class="empty">负责人正在准备练习内容，发布后可开始。</view><view class="acts"><button wx:if="{{catalog.configured}}" class="btn primary" bindtap="start" disabled="{{busy}}" loading="{{busy}}">开始练习</button></view></view>
    <block wx:if="{{displayQuestion}}"><view class="q-bar"><text>{{questionNumber}} / {{practice.total}}</text><view class="prog"><view class="i" style="width:{{progress}}%"></view></view><text>已答 {{practice.answeredCount}}</text></view><view class="q-card"><text class="q-num">QUESTION {{questionNumber}}</text><text class="q-tx">{{displayQuestion.prompt}}</text><button wx:for="{{displayQuestion.options}}" wx:key="index" class="opt {{feedback && feedback.rightIndex === index ? 'ok' : feedback && selectedIndex === index && !feedback.correct ? 'no' : selectedIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="select" disabled="{{busy || feedback}}"><text class="rad">{{optionLabels[index]}}</text><text>{{item}}</text></button></view><view wx:if="{{feedback}}" class="tip on {{feedback.correct ? '' : 'w'}}"><text>{{feedback.correct ? '✓ 回答正确' : '请核对正确答案'}}：{{feedback.rightText}}</text><text class="p">{{feedback.explanation}}</text></view><view class="acts"><button wx:if="{{!feedback}}" class="btn primary" bindtap="answer" disabled="{{busy}}" loading="{{busy}}">确认答案</button><button wx:else class="btn primary" bindtap="next">{{practice.status === 'completed' ? '查看本次结果' : '下一题'}}</button></view></block>
    <view wx:if="{{practice.status === 'completed' && !displayQuestion}}" class="learning-result"><text class="h3">本次练习已完成</text><view class="learning-score">{{practice.correctCount}}<text> / {{practice.total}}</text></view><text class="muted">答对题数</text><view class="tip on">本次知识练习已留档。活动资格仍以负责人核定和本场要求为准。</view><view class="acts"><button class="btn primary" bindtap="start" disabled="{{busy}}">再练习一次</button></view><button class="text-button full mt" bindtap="skills">查看基础控车项目 ›</button></view>
  </block>
  <view class="v2-extra">  <button wx:if="{{canManageContent}}" class="btn ghost secondary full mt" bindtap="toggleEditor">{{editor ? '收起题库维护' : '维护题库与发布状态'}}</button>
  <view wx:if="{{editor && bank}}" class="card learning-panel learning-editor"><view class="card-title">题库维护</view><view class="small muted mt">{{bank.questions.length}} 题 · {{bank.published ? '已发布' : '草稿'}} · v{{bank.revision}}</view><view class="notice">保存题目会暂停新的练习。至少二十题，经指导人员核定后再发布；已开始的练习保留原版本。</view><picker wx:if="{{questionLabels.length}}" range="{{questionLabels}}" bindchange="chooseQuestion"><view class="picker">选择已有题目修改 ›</view></picker><button class="text-button mt" bindtap="newQuestion">＋ 新增一道题</button><view class="field"><text class="field-label">题目编号</text><input value="{{draft.id}}" data-field="id" bindinput="field" maxlength="60" placeholder="例如 club-001"/></view><view class="field"><text class="field-label">题目</text><textarea value="{{draft.prompt}}" data-field="prompt" bindinput="field" maxlength="400"/></view><view class="field"><text class="field-label">选项 A</text><input value="{{draft.option0}}" data-field="option0" bindinput="field" maxlength="160"/></view><view class="field"><text class="field-label">选项 B</text><input value="{{draft.option1}}" data-field="option1" bindinput="field" maxlength="160"/></view><view class="field"><text class="field-label">选项 C</text><input value="{{draft.option2}}" data-field="option2" bindinput="field" maxlength="160"/></view><view class="field"><text class="field-label">选项 D</text><input value="{{draft.option3}}" data-field="option3" bindinput="field" maxlength="160"/></view><picker range="{{optionLabels}}" value="{{draft.rightIndex}}" bindchange="rightAnswer"><view class="picker">正确答案：{{optionLabels[draft.rightIndex]}} ›</view></picker><view class="field"><text class="field-label">答案说明</text><textarea value="{{draft.explanation}}" data-field="explanation" bindinput="field" maxlength="600"/></view><view class="field"><text class="field-label">核定／变更依据</text><textarea value="{{reason}}" data-field="reason" bindinput="field" maxlength="500" placeholder="记录指导人员核实情况与本次调整原因"/></view><button class="btn ghost secondary full" bindtap="saveQuestion" disabled="{{busy}}">保存题目为草稿</button><checkbox-group bindchange="instructor"><label class="check-line mt"><checkbox value="confirmed" checked="{{instructorConfirmed}}" color="#ff6b00"/><text>题目、答案和说明已由指导人员核定</text></label></checkbox-group><button class="btn primary full mt" bindtap="publish" disabled="{{busy}}">{{bank.published ? '暂停新练习' : '发布这份题库'}}</button></view>
</view>
</view></view></view>