page{background:#0a0a0a;color:#fff}.dossier-page{padding:32rpx 28rpx 72rpx}.page-heading{display:flex;flex-direction:column;margin-bottom:28rpx}.eyebrow{font-size:18rpx;letter-spacing:5rpx;color:#ff6b00}.page-title{font-size:44rpx;font-weight:700;margin:8rpx 0}.page-subtitle,.muted{color:#a8a8a8;font-size:23rpx;line-height:1.7}.notice,.status-card,.purpose,.section,.action-panel,.queue-card{background:#1a1a1a;border:1rpx solid #2a2a2a;border-radius:20rpx;padding:26rpx;margin-bottom:24rpx}.notice{font-size:25rpx;line-height:1.7}.error{border-color:#71352e;color:#ffa79d}.success{border-color:#28583b;color:#9ce8ba}.status-card{display:flex;flex-direction:column;gap:8rpx;border-left:5rpx solid #ff6b00}.status{font-size:29rpx;font-weight:600}.review-note{color:#f5c542;font-size:25rpx;line-height:1.7}.purpose{display:flex;flex-direction:column;gap:14rpx;background:#19120c;border-color:#4b3020;color:#c0b4aa;font-size:23rpx;line-height:1.8}.section-label{color:#ff8a3d;font-weight:600}.section-head,.switch-row,.media-status{display:flex;justify-content:space-between;align-items:center;gap:16rpx}.section-head{margin-bottom:16rpx}.section-title{font-size:28rpx;font-weight:600}.section-help{display:block;color:#a8a8a8;font-size:22rpx;line-height:1.8;margin:10rpx 0 20rpx}.field{display:flex;flex-direction:column;padding:20rpx 0;border-bottom:1rpx solid #2a2a2a;gap:12rpx;font-size:25rpx}.field>text{color:#c4c4c4}.field input,.field textarea,.action-panel textarea{font-size:27rpx;color:#fff;width:100%;box-sizing:border-box;min-height:54rpx}.field textarea{min-height:120rpx}.placeholder{color:#6e6e6e}.picker-value{padding:7rpx 0;color:#ff8a3d}.switch-row{padding:28rpx 0 6rpx;font-size:25rpx}.switch-row>view{display:flex;flex-direction:column;gap:8rpx}.switch-row switch{flex-shrink:0;transform:scale(.8);transform-origin:right center}.gear-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.photo-card{background:#121212;border:1rpx solid #2a2a2a;border-radius:14rpx;padding:14rpx;display:flex;flex-direction:column;gap:12rpx;min-width:0}.photo-name{font-size:23rpx;color:#c9c9c9}.photo-card image,.photo-empty{height:180rpx;width:100%;border-radius:10rpx;background:#222}.photo-empty{display:flex;align-items:center;justify-content:center;color:#717171;font-size:22rpx}.photo-error{color:#ffa79d;font-size:21rpx;line-height:1.6}.small-button,.remove-button,.text-button{font-size:22rpx;line-height:2.4;margin:0;padding:0 14rpx;border-radius:8rpx;background:transparent;color:#ff8a3d}.small-button{border:1rpx solid #453224}.small-button::after,.remove-button::after,.text-button::after{border:none}.bike-card{margin:22rpx 0;border-top:1rpx solid #333;padding-top:24rpx}.bike-title{font-weight:600;font-size:27rpx}.remove-button{color:#dba69e;margin-left:auto}.bike-card .gear-grid{margin-top:24rpx}.primary,.secondary{width:100%;font-size:27rpx;line-height:3;border-radius:12rpx;margin:18rpx 0 0}.primary{background:#ff6b00;color:#fff}.secondary{background:#222;color:#eee;border:1rpx solid #3b3b3b}.primary::after,.secondary::after{border:none}.primary[disabled],.secondary[disabled],.small-button[disabled]{background:#242424;color:#6e6e6e}.media-status{color:#a8a8a8;font-size:23rpx;margin:8rpx 0 22rpx}.uploading{display:block;color:#ff8a3d;font-size:24rpx;margin-bottom:22rpx}.consent{display:flex;align-items:flex-start;gap:12rpx;font-size:23rpx;color:#bcbcbc;line-height:1.8}.consent checkbox{transform:scale(.72);transform-origin:top left;flex-shrink:0;width:35rpx}.action-panel textarea{background:#111;padding:20rpx;border-radius:10rpx;margin-top:20rpx;min-height:150rpx}.loading,.empty{padding:45rpx 20rpx;text-align:center;color:#a8a8a8;font-size:25rpx}.empty{display:flex;flex-direction:column;gap:14rpx}.empty-title{font-size:31rpx;color:#fff}.queue-card{display:flex;justify-content:space-between;align-items:center}.queue-card>view{display:flex;flex-direction:column;gap:8rpx}.queue-name{font-size:30rpx;font-weight:600}.arrow{font-size:25rpx;color:#ff8a3d;flex