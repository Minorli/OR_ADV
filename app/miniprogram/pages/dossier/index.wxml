<view class="dossier-page">
  <view class="page-heading"><text class="eyebrow">RIDER DOSSIER</text><text class="page-title">{{mode === 'queue' ? '资料审核' : mode === 'review' ? '核对提交资料' : '骑手资料'}}</text><text class="page-subtitle">{{mode === 'own' ? '分次准备，保存后可以继续填写。' : '仅核对成员主动提交的这一版本。'}}</text></view>
  <view wx:if="error" class="notice error">{{error}}<button class="text-button" bindtap="retry" disabled="{{saving || uploading}}">重试</button></view>
  <view wx:if="notice" class="notice success">{{notice}}</view>
  <view wx:if="loading" class="loading">正在加载资料…</view>

  <block wx:if="mode === 'queue'">
    <view wx:if="!loading && !queue.length && !error" class="empty"><text class="empty-title">没有待审资料</text><text>成员提交后，会显示在这里。</text></view>
    <view wx:for="{{queue}}" wx:key="memberId" class="queue-card" data-id="{{item.memberId}}" bindtap="reviewMember"><view><text class="queue-name">{{item.nickname}}</text><text class="muted">编号 {{item.memberNumber === undefined ? '待分配' : item.memberNumber}} · 提交版本 {{item.submissionRevision}}</text><text class="muted">{{item.submittedAt}}</text></view><text class="arrow">查看 ›</text></view>
    <button wx:if="nextCursor" class="secondary" disabled="{{loading}}" bindtap="more">继续查看</button>
  </block>

  <block wx:elif="dossier">
    <view class="status-card"><text class="status">{{statusText}}</text><text class="muted">{{dirty ? '有未保存的修改。保存后需重新提交审核。' : '资料版本 ' + dossier.revision}}</text><text wx:if="dossier.review" class="review-note">核对说明：{{dossier.review.reason}}</text><text wx:if="mode === 'review' && dossier.submission" class="muted">本页展示提交快照 · {{dossier.submission.submissionRevision}} 版</text></view>
    <view class="purpose"><text class="section-label">本轮资料用途</text><text>用于俱乐部骑行准备、装备核对和必要联络。草稿仅本人可见；提交后仅主理人可以核对。</text><text>证件号码、血型、病史和证照照片暂不收集。后续核验项目、查看权限及保存期限待组织方确定。</text><text>资料通过与成员身份、积分、技能资格分别管理。</text></view>

    <view class="section"><view class="section-head"><text class="section-title">01 · 骑手信息</text><text class="muted">本次联络使用</text></view>
      <label class="field"><text>骑手称呼</text><input value="{{draft.riderName}}" maxlength="40" placeholder="希望组织方如何称呼你" placeholder-class="placeholder" data-field="riderName" bindinput="field" disabled="{{mode !== 'own' || saving}}" /></label>
      <label class="field"><text>骑行经历</text><textarea value="{{draft.ridingExperience}}" maxlength="300" placeholder="骑行年限、常用路况与需要的协助" placeholder-class="placeholder" data-field="ridingExperience" bindinput="field" disabled="{{mode !== 'own' || saving}}" auto-height="{{true}}" /></label>
      <view class="field"><text>联系渠道</text><picker range="{{contactMethods}}" value="{{draft.contactMethod === 'phone' ? 1 : 0}}" bindchange="contactMethod" disabled="{{mode !== 'own' || saving}}"><view class="picker-value">{{draft.contactMethod === 'phone' ? '电话' : '微信'}}<text wx:if="mode === 'own'"> ›</text></view></picker></view>
      <label class="field"><text>{{draft.contactMethod === 'phone' ? '联系电话' : '微信号'}}</text><input value="{{draft.contactValue}}" maxlength="80" placeholder="仅用于组织联络" placeholder-class="placeholder" data-field="contactValue" bindinput="field" disabled="{{mode !== 'own' || saving}}" /></label>
      <view class="switch-row"><view><text>紧急联系人</text><text class="muted">可选；填写前请取得联系人的同意</text></view><switch checked="{{emergencyEnabled}}" color="#ff6b00" bindchange="emergency" disabled="{{mode !== 'own' || saving}}" /></view>
      <block wx:if="emergencyEnabled"><label class="field"><text>联系人称呼</text><input value="{{draft.emergencyContact.name}}" maxlength="40" data-field="name" bindinput="emergencyField" disabled="{{mode !== 'own' || saving}}" /></label><label class="field"><text>联系电话</text><input value="{{draft.emergencyContact.phone}}" maxlength="30" data-field="phone" bindinput="emergencyField" disabled="{{mode !== 'own' || saving}}" /></label><label class="field"><text>与你的关系</text><input value="{{draft.emergencyContact.relationship}}" maxlength="30" data-field="relationship" bindinput="emergencyField" disabled="{{mode !== 'own' || saving}}" /></label></block>
    </view>

    <view class="section"><view class="section-head"><text class="section-title">02 · 护具照片</text><text class="muted">四项分别准备</text></view><text class="section-help">拍清护具整体与关键部位。上传只表示收到照片，审核结论由主理人填写。</text><view class="gear-grid"><view wx:for="{{gearRows}}" wx:key="key" class="photo-card"><text class="photo-name">{{item.name}}</text><image wx:if="item.url" src="{{item.url}}" mode="aspectFill" data-asset-id="{{item.assetId}}" bindtap="preview" binderror="photoFailed" /><view wx:else class="photo-empty">{{item.assetId ? '照片暂未显示' : '未添加照片'}}</view><text wx:if="item.error" class="photo-error">{{item.error}}</text><button wx:if="mode === 'own'" class="small-button" data-gear="{{item.key}}" bindtap="upload" disabled="{{saving || uploading}}">{{item.assetId ? '更换照片' : '添加照片'}}</button></view></view></view>

    <view class="section"><view class="section-head"><text class="section-title">03 · 常用车辆</text><text class="muted">{{draft.bikes.length}} / 3 辆</text></view><text class="section-help">至少填写一辆。每辆车分别上传车辆和轮胎照片，方便出发前核对。</text>
      <view wx:for="{{bikeRows}}" wx:key="id" wx:for-item="bike" wx:for-index="bikeIndex" class="bike-card"><view class="section-head"><text class="bike-title">车辆 {{bikeIndex + 1}}</text><button wx:if="mode === 'own'" class="remove-button" data-id="{{bike.id}}" bindtap="removeBike" disabled="{{saving || uploading}}">移除</button></view>
        <label class="field"><text>品牌</text><input value="{{bike.brand}}" maxlength="40" placeholder="车辆品牌" placeholder-class="placeholder" data-id="{{bike.id}}" data-field="brand" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}" /></label><label class="field"><text>车型</text><input value="{{bike.model}}" maxlength="80" placeholder="具体车型" placeholder-class="placeholder" data-id="{{bike.id}}" data-field="model" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}" /></label>
        <label class="field"><text>年份（可选）</text><input value="{{bike.year}}" type="number" maxlength="4" placeholder="例如 2023" placeholder-class="placeholder" data-id="{{bike.id}}" data-field="year" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}" /></label><label class="field"><text>车牌备注（可选）</text><input value="{{bike.plate}}" maxlength="30" placeholder="可留空" placeholder-class="placeholder" data-id="{{bike.id}}" data-field="plate" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}" /></label><label class="field"><text>里程 km（可选）</text><input value="{{bike.odometerKm}}" type="number" placeholder="仪表当前里程" placeholder-class="placeholder" data-id="{{bike.id}}" data-field="odometerKm" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}" /></label>
        <view class="gear-grid"><view class="photo-card"><text class="photo-name">车辆整体</text><image wx:if="bike.photoUrl" src="{{bike.photoUrl}}" mode="aspectFill" data-asset-id="{{bike.photoAssetId}}" bindtap="preview" binderror="photoFailed" /><view wx:else class="photo-empty">{{bike.photoAssetId ? '照片暂未显示' : '未添加照片'}}</view><text wx:if="bike.photoError" class="photo-error">{{bike.photoError}}</text><button wx:if="mode === 'own'" class="small-button" data-bike-id="{{bike.id}}" data-part="photoAssetId" bindtap="upload" disabled="{{saving || uploading}}">{{bike.photoAssetId ? '更换照片' : '添加照片'}}</button></view><view class="photo-card"><text class="photo-name">本车轮胎</text><image wx:if="bike.tireUrl" src="{{bike.tireUrl}}" mode="aspectFill" data-asset-id="{{bike.tireAssetId}}" bindtap="preview" binderror="photoFailed" /><view wx:else class="photo-empty">{{bike.tireAssetId ? '照片暂未显示' : '未添加照片'}}</view><text wx:if="bike.tireError" class="photo-error">{{bike.tireError}}</text><button wx:if="mode === 'own'" class="small-button" data-bike-id="{{bike.id}}" data-part="tireAssetId" bindtap="upload" disabled="{{saving || uploading}}">{{bike.tireAssetId ? '更换照片' : '添加照片'}}</button></view></view>
      </view>
      <button wx:if="mode === 'own' && draft.bikes.length !== 3" class="secondary" bindtap="addBike" disabled="{{saving || uploading}}">＋ 添加车辆</button>
    </view>

    <view wx:if="mode === 'own' && pendingUploads.length" class="section"><text class="section-title">尚未传完的照片</text><text class="section-help">照片原件保存在当前设备。上传成功后请保存资料；已移除车辆的待传照片可以删除。</text><view wx:for="{{pendingUploads}}" wx:key="draftId" class="pending-upload"><text>{{item.label}}</text><view><button class="text-button" data-id="{{item.draftId}}" bindtap="retryUpload" disabled="{{saving || uploading || !item.available}}">重试上传</button><button class="remove-button" data-id="{{item.draftId}}" bindtap="discardUpload" disabled="{{saving || uploading}}">移除</button></view></view></view>
    <view class="media-status"><text>已准备 {{photoCount}} / {{photoTotal}} 张照片</text><button class="text-button" bindtap="retryPhotos" disabled="{{uploading}}">重试</button></view><text wx:if="uploading" class="uploading">正在处理{{uploadLabel}}，请稍候…</text>
    <view wx:if="mode === 'own'" class="action-panel"><checkbox-group bindchange="consent"><label class="consent"><checkbox value="accepted" checked="{{consent}}" color="#ff6b00" /><text>我已阅读以上用途，确认资料由本人提交且有权提供；填写紧急联系人时已取得其同意。</text></label></checkbox-group><button class="secondary" bindtap="save" disabled="{{saving || uploading}}" loading="{{saving}}">保存草稿</button><button class="primary" bindtap="submit" disabled="{{saving || uploading || (!dirty && (dossier.status === 'pending' || dossier.status === 'approved'))}}">{{dossier.status === 'returned' || dirty ? '提交当前资料审核' : '提交审核'}}</button><text class="section-help">提交后仍可修改；保存修改会使上一份结论失效，需重新提交。</text></view>
    <view wx:elif="mode === 'review' && dossier.status === 'pending'" class="action-panel"><text class="section-title">本次核对结论</text><textarea value="{{reviewReason}}" maxlength="500" placeholder="填写核对依据；退回时写清需要补充的项目" placeholder-class="placeholder" bindinput="reviewReason" disabled="{{saving}}" auto-height="{{true}}" /><button class="secondary" data-decision="returned" bindtap="review" disabled="{{saving}}">退回补充</button><button class="primary" data-decision="approved" bindtap="review" disabled="{{saving}}">通过本次资料审核</button></view>
  </block>
</view>
