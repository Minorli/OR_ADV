<view class="page reference-v2 dossier-leaf {{embedded ? 'is-embedded' : ''}}"><view class="v2-modal-content"><view class="shd"><text class="h3">{{mode === 'queue' ? '资料审核' : mode === 'review' ? '核对提交资料' : '个人资料审核'}}</text><button class="x" bindtap="referenceClose" aria-label="关闭资料审核">✕</button></view><view class="bdy">
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="retry" disabled="{{saving || uploading}}">重试</button></view><view wx:if="{{notice}}" class="notice">{{notice}}</view><view wx:if="{{loading}}" class="loading">正在加载资料…</view>
  <block wx:if="{{mode === 'queue'}}"><view wx:if="{{!loading && !queue.length && !error}}" class="empty">没有待审资料，成员提交后会显示在这里。</view><view class="assess-list"><button wx:for="{{queue}}" wx:key="memberId" class="ai" data-id="{{item.memberId}}" bindtap="reviewMember"><view class="pl"><text class="b">{{item.nickname}}</text><text class="span">编号 {{item.memberNumber === undefined ? '待分配' : item.memberNumber}} · 版本 {{item.submissionRevision}}</text><text class="span">{{item.submittedAt}}</text></view><text>查看 ›</text></button></view><button wx:if="{{nextCursor}}" class="btn ghost" disabled="{{loading}}" bindtap="more">继续查看</button></block>
  <block wx:elif="{{dossier}}">
    <view class="tip-bar"><text class="b">请按实际情况填写骑行资料。</text><text>用于骑行准备、装备核对和必要联络。草稿仅本人可见；提交后仅授权主理人可核对。资料审核与成员身份、积分、技能资格分别管理。</text></view>
    <view class="sec-t"><text class="b">一、个人基础信息</text><text class="req">本人填写</text><view class="ln"></view></view><text class="muted">用于本次组织联络，请勿填写证件号码和健康信息。</text>
    <view class="info-row"><view class="lb"><text class="b">骑手称呼</text><text class="span">希望组织方如何称呼你</text></view><input class="cv row-input" value="{{draft.riderName}}" maxlength="40" placeholder="待填写" data-field="riderName" bindinput="field" disabled="{{mode !== 'own' || saving}}"/></view>
    <view class="info-row"><view class="lb"><text class="b">年龄</text><text class="span">尚未开放此项填写</text></view><text class="cv n">未启用</text></view>
    <view class="info-row"><view class="lb"><text class="b">血型</text><text class="span">本次不采集健康信息</text></view><text class="cv n">未启用</text></view>
    <view class="info-row"><view class="lb"><text class="b">身份证号</text><text class="span">本次不采集证件号码</text></view><text class="cv n">未启用</text></view>
    <view class="info-row"><view class="lb"><text class="b">联系渠道</text><text class="span">仅用于组织联络</text></view><picker range="{{contactMethods}}" value="{{draft.contactMethod === 'phone' ? 1 : 0}}" bindchange="contactMethod" disabled="{{mode !== 'own' || saving}}"><text class="cv">{{draft.contactMethod === 'phone' ? '电话' : '微信'}} ›</text></picker></view>
    <view class="info-row"><view class="lb"><text class="b">{{draft.contactMethod === 'phone' ? '联系电话' : '微信号'}}</text><text class="span">仅本人及授权主理人可见</text></view><input class="cv row-input" value="{{draft.contactValue}}" maxlength="80" placeholder="待填写" data-field="contactValue" bindinput="field" disabled="{{mode !== 'own' || saving}}"/></view>
    <view class="info-row"><view class="lb"><text class="b">紧急联系人</text><text class="span">选填；填写前请取得对方同意</text></view><switch checked="{{emergencyEnabled}}" color="#ff6b00" bindchange="emergency" disabled="{{mode !== 'own' || saving}}"/></view>
    <view wx:if="{{emergencyEnabled}}" class="emergency-fields"><view class="info-row"><text class="muted">称呼</text><input class="cv row-input" value="{{draft.emergencyContact.name}}" maxlength="40" data-field="name" bindinput="emergencyField" disabled="{{mode !== 'own' || saving}}"/></view><view class="info-row"><text class="muted">电话</text><input class="cv row-input" value="{{draft.emergencyContact.phone}}" maxlength="30" data-field="phone" bindinput="emergencyField" disabled="{{mode !== 'own' || saving}}"/></view><view class="info-row"><text class="muted">关系</text><input class="cv row-input" value="{{draft.emergencyContact.relationship}}" maxlength="30" data-field="relationship" bindinput="emergencyField" disabled="{{mode !== 'own' || saving}}"/></view></view>
    <view class="info-row"><view class="lb"><text class="b">驾驶证照片</text><text class="span">本次不采集证照照片</text></view><text class="cv n">未启用</text></view><view class="info-row"><view class="lb"><text class="b">摩托车行驶证</text><text class="span">本次不采集证照照片</text></view><text class="cv n">未启用</text></view><view class="info-row"><view class="lb"><text class="b">既往病史 / 过敏史</text><text class="span">本次不采集健康信息</text></view><text class="cv n">未启用</text></view><view class="info-row"><view class="lb"><text class="b">队服尺码</text><text class="span">尺码登记暂未开放</text></view><text class="cv n">未启用</text></view>
    <view class="field"><text class="field-label">骑行经历</text><textarea value="{{draft.ridingExperience}}" maxlength="300" placeholder="骑行年限、常用路况与需要的协助" data-field="ridingExperience" bindinput="field" disabled="{{mode !== 'own' || saving}}" auto-height="{{true}}"/></view>
    <view class="sec-t"><text class="b">二、全套护具照片</text><text class="req">逐项准备</text><view class="ln"></view></view><text class="muted">头盔 / 护甲 / 护膝护胫 / 越野靴，拍清整体与关键部位。</text><view class="gear-grid"><view wx:for="{{gearRows}}" wx:key="key" class="gc"><button class="up-cell {{item.assetId ? 'done' : ''}}" data-gear="{{item.key}}" bindtap="openUpload" disabled="{{mode !== 'own' || saving || uploading}}"><image wx:if="{{item.url}}" class="uploaded-thumb" src="{{item.url}}" mode="aspectFill" data-asset-id="{{item.assetId}}" binderror="photoFailed"/><image wx:else class="i" src="/assets/icons/v2-upload.png" mode="aspectFit"/><text class="span">{{item.assetId ? '✓' : '+ 上传'}}</text></button><text class="span">{{item.name}}</text><button wx:if="{{item.url}}" class="text-button photo-preview" data-asset-id="{{item.assetId}}" bindtap="preview">查看</button><text wx:if="{{item.error}}" class="photo-error">{{item.error}}</text></view></view>
    <view class="sec-t"><text class="b">三、车辆信息</text><text class="req">{{draft.bikes.length}} / 3 辆</text><view class="ln"></view></view><text class="muted">填写常用车辆，逐台准备车辆及轮胎照片。</text><view class="up-list"><view wx:for="{{bikeRows}}" wx:key="id" wx:for-item="bike" wx:for-index="bikeIndex" class="bike-record"><view class="up-item"><button class="up-cell {{bike.photoAssetId ? 'done' : ''}}" data-bike-id="{{bike.id}}" data-part="photoAssetId" bindtap="openUpload" disabled="{{mode !== 'own' || saving || uploading}}"><image wx:if="{{bike.photoUrl}}" class="uploaded-thumb" src="{{bike.photoUrl}}" mode="aspectFill" data-asset-id="{{bike.photoAssetId}}" binderror="photoFailed"/><image wx:else class="i" src="/assets/icons/v2-upload.png" mode="aspectFit"/><text class="span">{{bike.photoAssetId ? '✓' : '+ 照片'}}</text></button><view class="nm"><text class="b">{{bike.brand || '车辆'}} {{bike.model || bikeIndex + 1}}</text><text class="em">{{bike.year || '年份待填'}} · {{bike.odometerKm === null ? '里程待填' : bike.odometerKm + 'km'}}</text></view><button wx:if="{{bike.photoUrl}}" class="cv" data-asset-id="{{bike.photoAssetId}}" bindtap="preview">查看</button><button wx:if="{{mode === 'own'}}" class="remove-button" data-id="{{bike.id}}" bindtap="removeBike" disabled="{{saving || uploading}}">移除</button></view><view class="bike-fields"><input value="{{bike.brand}}" maxlength="40" placeholder="品牌" data-id="{{bike.id}}" data-field="brand" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}"/><input value="{{bike.model}}" maxlength="80" placeholder="车型" data-id="{{bike.id}}" data-field="model" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}"/><input value="{{bike.year}}" type="number" maxlength="4" placeholder="年份（选填）" data-id="{{bike.id}}" data-field="year" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}"/><input value="{{bike.plate}}" maxlength="30" placeholder="车牌备注（选填）" data-id="{{bike.id}}" data-field="plate" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}"/><input value="{{bike.odometerKm}}" type="number" placeholder="当前里程km（选填）" data-id="{{bike.id}}" data-field="odometerKm" bindinput="bikeField" disabled="{{mode !== 'own' || saving}}"/></view><text wx:if="{{bike.photoError}}" class="photo-error">{{bike.photoError}}</text></view></view><button wx:if="{{mode === 'own' && draft.bikes.length !== 3}}" class="add-bike" bindtap="addBike" disabled="{{saving || uploading}}">＋ 添加车辆<text class="muted">最多保存 3 辆</text></button>
    <view class="sec-t"><text class="b">四、轮胎状态</text><text class="req">逐台准备</text><view class="ln"></view></view><text class="muted">拍清前后轮胎纹、品牌与磨损情况，供出发前装备核对。</text><view class="up-list"><view wx:for="{{bikeRows}}" wx:key="id" wx:for-item="bike" class="up-item"><button class="up-cell {{bike.tireAssetId ? 'done' : ''}}" data-bike-id="{{bike.id}}" data-part="tireAssetId" bindtap="openUpload" disabled="{{mode !== 'own' || saving || uploading}}"><image wx:if="{{bike.tireUrl}}" class="uploaded-thumb" src="{{bike.tireUrl}}" mode="aspectFill" data-asset-id="{{bike.tireAssetId}}" binderror="photoFailed"/><image wx:else class="i" src="/assets/icons/v2-upload.png" mode="aspectFit"/><text class="span">{{bike.tireAssetId ? '✓' : '+ 上传'}}</text></button><view class="nm"><text class="b">{{bike.brand || '车辆'}} {{bike.model}}</text><text class="em">{{bike.tireAssetId ? '已添加照片，待核对' : '待添加本车轮胎照片'}}</text><text wx:if="{{bike.tireError}}" class="photo-error">{{bike.tireError}}</text></view><button wx:if="{{bike.tireUrl}}" class="cv" data-asset-id="{{bike.tireAssetId}}" bindtap="preview">查看</button></view></view>
    <view class="tip-bar {{dossier.status === 'returned' ? 'r' : ''}} mt"><text class="b">{{statusText}}</text><text class="p">已准备 {{photoCount}} / {{photoTotal}} 张照片{{dirty ? '，有未保存修改。' : '。'}}</text><text wx:if="{{dossier.review}}" class="p">核对说明：{{dossier.review.reason}}</text><text wx:if="{{mode === 'review' && dossier.submission}}" class="p">本页展示提交快照 {{dossier.submission.submissionRevision}} 版。</text><text class="p">照片齐全不代表审核通过。保存修改后需重新提交，由主理人填写结论。</text></view>
    <view wx:if="{{mode === 'own' && pendingUploads.length}}" class="v2-extra"><view class="sec-t"><text class="b">尚未传完的照片</text></view><view wx:for="{{pendingUploads}}" wx:key="draftId" class="info-row"><view class="lb"><text class="b">{{item.label}}</text><text class="span">原件保留在当前设备，上传后请保存资料。</text></view><button class="text-button" data-id="{{item.draftId}}" bindtap="retryUpload" disabled="{{saving || uploading || !item.available}}">重试</button><button class="remove-button" data-id="{{item.draftId}}" bindtap="discardUpload" disabled="{{saving || uploading}}">移除</button></view></view><button class="text-button full mt" bindtap="retryPhotos" disabled="{{uploading}}">刷新照片</button><text wx:if="{{uploading}}" class="muted">正在处理{{uploadLabel}}…</text>
    <view wx:if="{{mode === 'own'}}" class="v2-extra"><checkbox-group bindchange="consent"><label class="check-line"><checkbox value="accepted" checked="{{consent}}" color="#ff6b00"/><text>确认由本人提交且有权提供；填写紧急联系人时已取得对方同意。</text></label></checkbox-group><view class="acts"><button class="btn ghost" bindtap="save" disabled="{{saving || uploading}}" loading="{{saving}}">保存草稿</button><button class="btn primary" bindtap="submit" disabled="{{saving || uploading || (!dirty && (dossier.status === 'pending' || dossier.status === 'approved'))}}">提交审核</button></view></view>
    <view wx:elif="{{mode === 'review' && dossier.status === 'pending'}}" class="v2-extra"><view class="field"><text class="field-label">本次核对依据</text><textarea value="{{reviewReason}}" maxlength="500" placeholder="退回时写清需要补充的项目" bindinput="reviewReason" disabled="{{saving}}" auto-height="{{true}}"/></view><view class="acts"><button class="btn ghost" data-decision="returned" bindtap="review" disabled="{{saving}}">退回补充</button><button class="btn primary" data-decision="approved" bindtap="review" disabled="{{saving}}">通过审核</button></view></view>
  </block>
</view></view>
  <view wx:if="{{uploadTarget}}" class="upload-dialog"><view class="upload-mask" bindtap="closeUpload"></view><view class="v2-modal-content upload-content"><view class="shd"><text class="h3">{{uploadTarget.label}}</text><button class="x" bindtap="closeUpload" aria-label="关闭上传选项">✕</button></view><view class="bdy"><view class="tip-bar">请上传清晰照片，确保关键信息可辨认。照片仅用于本人资料及授权审核。</view><view class="up-list"><button class="up-item upload-source" data-source="album" bindtap="uploadFrom"><view class="up-cell"><image class="i" src="/assets/icons/v2-upload.png" mode="aspectFit"/></view><view class="nm"><text class="b">相册选择</text><text class="em">选择已拍好的照片</text></view><text class="cv">选择 ›</text></button><button class="up-item upload-source" data-source="camera" bindtap="uploadFrom"><view class="up-cell"><image class="i" src="/assets/icons/v2-camera.png" mode="aspectFit"/></view><view class="nm"><text class="b">现场拍照</text><text class="em">请在光线充足处拍摄</text></view><text class="cv">拍照 ›</text></button></view></view></view></view>
</view>
