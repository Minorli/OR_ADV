<view class="page">
  <view class="eyebrow">CLUB MANAGEMENT</view><view class="title">会员与俱乐部</view><view class="subtitle">按昵称和编号核对成员，分别设置业务身份、工作权限与技能资格。</view>
  <view wx:if="{{loading}}" class="loading">正在核对管理权限…</view>
  <view wx:if="{{error}}" class="notice error">{{error}}<button class="text-button" bindtap="load">刷新</button></view>
  <view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{!authorized && !canManageHero && !loading}}" class="empty">仅主理人、车队经理与内容管理员可管理此处资料。<button class="secondary full mt" bindtap="back">返回工作台</button></view>
  <block wx:if="{{authorized || canManageHero}}"><view class="member-admin-banner"><text>{{adminTitle || '内容管理员'}}</text><text>{{authorized ? '业务身份与工作权限分开设置' : '管理俱乐部首页轮播图展示'}}</text></view>
    <view class="filter-row"><button wx:if="{{authorized}}" class="pill {{pane === 'members' ? 'active' : ''}}" data-pane="members" bindtap="pane">会员管理</button><button wx:if="{{authorized}}" class="pill {{pane === 'settings' ? 'active' : ''}}" data-pane="settings" bindtap="pane">公开联络设置</button><button class="pill {{pane === 'hero' ? 'active' : ''}}" data-pane="hero" bindtap="pane">首页轮播图</button></view>
    <block wx:if="{{authorized && pane === 'members'}}">
      <view class="search-row"><input value="{{query}}" maxlength="30" bindinput="query" bindconfirm="search" placeholder="搜索昵称或完整成员编号"/><button class="secondary" bindtap="search">查找</button></view>
      <view class="small muted mt">查看成员资料。成员身份不授予员工权限，俱乐部成员与创始合伙人使用同一套安全核验标准。</view>
      <view wx:if="{{!loadingMore && !items.length}}" class="empty">没有找到匹配会员。</view>
      <view wx:for="{{items}}" wx:key="id" class="card mt" data-id="{{item.id}}" bindtap="select"><view class="row"><text class="card-title">{{item.nickname}}</text><text class="tag {{item.memberKind === 'founder' ? 'tag-dark' : ''}}">{{item.memberKind === 'founder' ? '创始合伙人' : '俱乐部成员'}}</text></view><view class="member-code tiny muted mt">成员编号 · {{item.memberCode}}</view><view wx:if="{{item.roleBadges.length || item.vBadges.length}}" class="member-role-badges"><text wx:for="{{item.vBadges}}" wx:for-item="vBadge" wx:key="id" class="badge-chip badge-chip--{{vBadge.tone}}">V {{vBadge.label}}</text><text wx:for="{{item.roleBadges}}" wx:for-item="badge" wx:key="*this" class="tag tag-dark">{{badge}}</text></view><view class="row small mt"><text class="muted">{{item.kindRequestStatus === 'pending' ? '身份核实待处理' : '查看身份、+V挂件、授权与技能'}}</text><text>管理 →</text></view></view>
      <button wx:if="{{nextCursor}}" class="secondary full" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="more">查看更多成员</button>
      <view wx:if="{{selected}}" class="card mt member-editor">
        <view class="row"><text class="card-title">{{selected.nickname}}</text><text class="tag">{{selected.memberKind === 'founder' ? '创始合伙人' : '俱乐部成员'}}</text></view>
        <view class="member-code tiny muted mt">成员编号 · {{selected.memberCode}} · 请通过既有可信联络渠道核对本人</view>
        <button class="secondary full mt" bindtap="viewDossier" disabled="{{!!busy}}">查看已提交的骑手资料 ›</button>
        <view wx:if="{{selected.roleBadges.length || selected.vBadges.length}}" class="member-role-badges"><text wx:for="{{selected.vBadges}}" wx:for-item="vBadge" wx:key="id" class="badge-chip badge-chip--{{vBadge.tone}}">V {{vBadge.label}}</text><text wx:for="{{selected.roleBadges}}" wx:for-item="badge" wx:key="*this" class="tag tag-dark">{{badge}}</text></view><view class="field"><text class="field-label">变更原因 / 核验依据（调整身份或角色时必填）</text><textarea value="{{reason}}" data-field="reason" bindinput="field" maxlength="500" placeholder="填写客观核实依据，不录入证件或敏感原件"/></view>
        <view class="section-title mt">成员 +V 认证挂件（可多选）</view><view class="small muted mt">勾选后头像右下角自动亮起最高优先级的彩色 V 挂件（橙V › 金V › 蓝V），全部已选头衔将在积分榜与本人资料页展示。</view>
        <view class="badge-grid"><button wx:for="{{badgeOptions}}" wx:key="id" class="badge-option tone-{{item.tone}} {{item.checked ? 'is-checked' : ''}}" data-badge="{{item.id}}" disabled="{{!!busy}}" bindtap="toggleBadge"><view class="badge-option-head"><view><text class="badge-option-v">V</text><text>{{item.label}}</text></view><text>{{item.checked ? '✓' : '＋'}}</text></view><text class="badge-option-desc">{{item.description}}</text></button></view>
        <button class="primary full mt" disabled="{{!!busy}}" loading="{{busy === 'badges'}}" bindtap="saveBadges">保存 +V 认证挂件</button>
        <view class="divider"></view><view class="section-title">业务身份</view><view class="small muted mt">创始身份可用于符合条件活动的自动确认；名额、活动门槛与技能要求继续生效。</view>
        <view class="row field"><picker mode="date" value="{{expiryDate}}" data-field="expiryDate" bindchange="field"><view class="picker">{{expiryDate || '创始身份到期日（选填）'}} ▾</view></picker><button class="text-button" bindtap="clearExpiry">不设到期日</button></view>
        <view class="actions"><button class="primary grow" data-kind="founder" disabled="{{!!busy}}" bindtap="assignKind">核实并设为创始合伙人</button><button class="secondary" data-kind="regular" disabled="{{!!busy}}" bindtap="assignKind">设为俱乐部成员</button></view>
        <view class="divider"></view><view class="section-title">推荐展示</view><view class="small muted mt">{{selected.recommendationOptIn ? '本人已同意公开推荐资料。' : '本人尚未同意公开，不会展示。'}} 调整顺序不会代替本人同意，也不改变积分。尚未公开时，请本人到「我的 → 公开展示」开启俱乐部推荐。</view>
        <view class="field"><text class="field-label">展示优先级（0–999，越大越优先）</text><input type="number" value="{{priority}}" data-field="priority" bindinput="field"/></view><button class="secondary full" disabled="{{!!busy}}" bindtap="savePriority">保存推荐顺序</button>
        <view class="divider"></view><view class="section-title">员工授权</view><view class="small muted mt">主理人与车队经理拥有完整业务管理权限。内容管理员只维护公开内容，不查看成员档案、私人咨询或积分记录。领队与核验员须指定活动。</view>
        <picker range="{{roleLabels}}" value="{{roleIndex}}" bindchange="role"><view class="picker mt">{{roleLabels[roleIndex]}} ▾</view></picker>
        <view wx:if="{{roleProtected}}" class="notice">可信主理人的权限长期有效，不能撤销、设置到期或直接注销。</view><view wx:if="{{roleValues[roleIndex] === 'owner' && !roleProtected}}" class="switch-row field"><text>显示称谓为车队经理</text><switch checked="{{roleManager}}" color="#ff6b00" bindchange="roleManager"/></view><view class="switch-row field"><text>启用该角色</text><switch checked="{{roleEnabled}}" disabled="{{roleProtected || !!busy}}" color="#ff6b00" bindchange="roleEnabled"/></view>
        <view class="row field"><picker mode="date" disabled="{{roleProtected || !!busy}}" value="{{roleExpiryDate}}" data-field="roleExpiryDate" bindchange="field"><view class="picker">{{roleExpiryDate || '员工授权到期日（选填）'}} ▾</view></picker><button class="text-button" bindtap="clearRoleExpiry" disabled="{{roleProtected}}">不设到期日</button></view>
        <checkbox-group wx:if="{{roleScoped}}" bindchange="scopes"><label wx:for="{{scopeOptions}}" wx:key="id" class="check-line"><checkbox value="{{item.id}}" checked="{{item.checked}}" color="#ff6b00"/><text>{{item.scopeLabel || item.title}}</text></label></checkbox-group>
        <view class="small muted" wx:if="{{roleScoped}}">只勾选本次需要授权的场次，当前选择 {{scopeIds.length}} 场。</view><button class="secondary full mt" disabled="{{!!busy}}" bindtap="saveRole">保存员工授权</button>
        <view class="divider"></view><view class="section-title">技能资格核验</view><view class="small muted mt">只记录实际核验结论；参加次数和积分不代表掌握技能。</view>
        <view wx:for="{{qualifications}}" wx:key="id" class="list-link" data-id="{{item.id}}" bindtap="qualification"><text>{{item.type === 'basic_control' ? '基础控车考核' : item.type}}</text><text class="tag">{{item.decision === 'approved' ? '已核验' : item.decision === 'rejected' ? '未通过' : '待核验'}}</text></view>
        <button wx:if="{{qualificationCursor}}" class="text-button" disabled="{{!!busy}}" bindtap="moreQualifications">查看更多技能资格</button>
        <view class="small muted mt">“基础控车考核”通过后，该成员自动进入积分榜。</view><view class="actions"><button class="secondary grow" data-type="basic_control" disabled="{{!!busy}}" bindtap="pickQualificationType">基础控车考核</button><button class="secondary" data-type="" disabled="{{!!busy}}" bindtap="pickQualificationType">其他项目</button></view><view class="field"><text class="field-label">技能项目</text><input value="{{qualificationType === 'basic_control' ? '基础控车考核' : qualificationType}}" disabled="{{qualificationType === 'basic_control'}}" data-field="qualificationType" bindinput="field" maxlength="60" placeholder="按俱乐部实际核验项目填写"/></view><picker mode="date" value="{{qualificationDate}}" data-field="qualificationDate" bindchange="field"><view class="picker">{{qualificationDate || '资格到期日（选填）'}} ▾</view></picker>
        <view class="actions"><button class="primary grow" data-decision="approved" disabled="{{!!busy}}" bindtap="reviewQualification">实际核验通过</button><button class="secondary" data-decision="rejected" disabled="{{!!busy}}" bindtap="reviewQualification">核验未通过</button></view>
      </view>
    </block>
    <view wx:if="{{authorized && pane === 'settings'}}" class="card">
      <view class="card-title">俱乐部公开联络信息</view><view class="notice">只填写经本人同意可公开、真实可用的信息。未知号码请留空核实，不使用示例号码代替。</view>
      <view class="field"><text class="field-label">公开名称</text><input value="{{settings.name}}" data-field="name" bindinput="settingsField" maxlength="60"/></view>
      <view class="field"><text class="field-label">公开联络人称呼</text><input value="{{settings.contactName}}" data-field="contactName" bindinput="settingsField" maxlength="30"/></view>
      <picker range="{{contactLabels}}" value="{{contactIndex}}" bindchange="contact"><view class="picker">{{contactLabels[contactIndex]}} ▾</view></picker>
      <view class="field"><text class="field-label">实际联系方式</text><input value="{{settings.contactValue}}" data-field="contactValue" bindinput="settingsField" maxlength="100" placeholder="已确认可公开的微信、电话或其他方式"/></view>
      <view class="field"><text class="field-label">联络说明</text><textarea value="{{settings.contactInstructions}}" data-field="contactInstructions" bindinput="settingsField" maxlength="500" placeholder="说明咨询方式、适合联络的时间与注意事项"/></view>
      <button class="primary full" disabled="{{!!busy}}" loading="{{busy === 'settings'}}" bindtap="saveSettings">核实并保存公开信息</button>
    </view>
    <view wx:if="{{pane === 'hero'}}" class="card">
      <view class="card-title">首页轮播图管理</view>
      <view class="notice">主理人与车队经理可直接上传更换首页轮播图与标语（最多 6 张）。首页轮播高度约占屏幕三分之一，建议选横版照片（比例约 4:3 或 16:10），系统自动居中裁切并压缩保存。未配置或全部移除保存时，首页自动使用内置默认轮播图。</view>
      <view wx:if="{{!heroSlides.length}}" class="small muted mt">当前使用内置默认 4 张轮播图。点击下方按钮上传自定义图片即可替换。</view>
      <view wx:for="{{heroSlides}}" wx:key="id" class="card mt hero-slide-editor">
        <view class="row"><text class="card-title">轮播 {{index + 1}}</text><view class="hero-slide-actions"><button wx:if="{{index > 0}}" class="text-button" data-index="{{index}}" data-delta="-1" disabled="{{!!busy}}" bindtap="moveHeroSlide">上移</button><button wx:if="{{index + 1 < heroSlides.length}}" class="text-button" data-index="{{index}}" data-delta="1" disabled="{{!!busy}}" bindtap="moveHeroSlide">下移</button><button class="text-button" data-index="{{index}}" disabled="{{!!busy}}" bindtap="removeHeroSlide">移除</button></view></view>
        <image class="hero-slide-preview mt" src="{{item.cover}}" mode="aspectFill"/>
        <view class="field"><text class="field-label">上标（选填，默认 ORIGINAL RALLY）</text><input value="{{item.kicker}}" data-index="{{index}}" data-field="kicker" bindinput="heroField" maxlength="40" disabled="{{!!busy}}"/></view>
        <view class="field"><text class="field-label">主标题（必填）</text><input value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="heroField" maxlength="80" placeholder="例如：不赶路，感受路" disabled="{{!!busy}}"/></view>
        <view class="field"><text class="field-label">副标题（选填）</text><input value="{{item.caption}}" data-index="{{index}}" data-field="caption" bindinput="heroField" maxlength="120" placeholder="补充一句话说明" disabled="{{!!busy}}"/></view>
      </view>
      <button wx:if="{{heroSlides.length < 6}}" class="secondary full mt" disabled="{{!!busy}}" loading="{{busy === 'hero-upload'}}" bindtap="uploadHeroSlide">＋ 从相册或相机上传轮播图（{{heroSlides.length}} / 6）</button>
      <checkbox-group wx:if="{{heroSlides.length}}" class="mt" bindchange="heroRights"><label class="check-line"><checkbox value="accepted" checked="{{heroRights}}" color="#ff6b00"/><text>确认所选图片已取得俱乐部公开展示授权。</text></label></checkbox-group>
      <button class="primary full mt" disabled="{{!!busy}}" loading="{{busy === 'hero-save'}}" bindtap="saveHero">{{heroSlides.length ? '保存并发布到首页' : '保存并恢复默认轮播图'}}</button>
    </view>
  </block>
</view>
