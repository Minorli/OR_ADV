{
  "pages": [
    "pages/activities/index",
    "pages/ranking/index",
    "pages/history/index",
    "pages/profile/index"
  ],
  "subpackages": [
    {
      "root": "subpackages/trip",
      "name": "pkg-trip",
      "pages": [
        "pages/activity/detail",
        "pages/registration/apply",
        "pages/trip/detail",
        "pages/mine/index",
        "pages/points/index"
      ]
    },
    {
      "root": "subpackages/archive",
      "name": "pkg-archive",
      "pages": [
        "pages/history-detail/index"
      ]
    },
    {
      "root": "subpackages/academy",
      "name": "pkg-academy",
      "pages": [
        "pages/learning/index",
        "pages/skills/index"
      ]
    },
    {
      "root": "subpackages/rider",
      "name": "pkg-rider",
      "pages": [
        "pages/dossier/index",
        "pages/redemption/index",
        "pages/club-content/index"
      ]
    },
    {
      "root": "subpackages/ops",
      "name": "pkg-ops",
      "pages": [
        "pages/staff/index",
        "pages/staff-members/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/activities/index": {
      "network": "all",
      "packages": [
        "pkg-trip",
        "pkg-rider"
      ]
    },
    "pages/ranking/index": {
      "network": "all",
      "packages": [
        "pkg-rider",
        "pkg-trip"
      ]
    },
    "pages/history/index": {
      "network": "all",
      "packages": [
        "pkg-archive"
      ]
    },
    "pages/profile/index": {
      "network": "all",
      "packages": [
        "pkg-rider",
        "pkg-academy",
        "pkg-trip"
      ]
    }
  },
  "window": {
    "navigationBarTitleText": "OriginalRally原始拉力",
    "navigationBarBackgroundColor": "#0a0a0a",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#0a0a0a",
    "backgroundColorTop": "#0a0a0a",
    "backgroundColorBottom": "#0a0a0a",
    "backgroundColorContent": "#0a0a0a",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "color": "#6e6e6e",
    "selectedColor": "#ff6b00",
    "backgroundColor": "#0a0a0a",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/activities/index",
        "text": "首页",
        "iconPath": "assets/tabs/v2-home.png",
        "selectedIconPath": "assets/tabs/v2-home-active.png"
      },
      {
        "pagePath": "pages/ranking/index",
        "text": "排行",
        "iconPath": "assets/tabs/v2-rank.png",
        "selectedIconPath": "assets/tabs/v2-rank-active.png"
      },
      {
        "pagePath": "pages/history/index",
        "text": "历史",
        "iconPath": "assets/tabs/v2-history.png",
        "selectedIconPath": "assets/tabs/v2-history-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "assets/tabs/v2-profile.png",
        "selectedIconPath": "assets/tabs/v2-profile-active.png"
      }
    ],
    "custom": true
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "reference-overlay": "/components/reference-overlay/index"
  }
}
