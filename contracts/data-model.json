{
  "status": "v0.2a_implemented_locally_not_deployed",
  "commonFields": {
    "_id": "server generated or deterministic ID",
    "clubId": "string",
    "createdAt": "timestamp(server)",
    "updatedAt": "timestamp(server)",
    "schemaVersion": "integer",
    "id": "deterministic logical document ID; CloudBase _id equals id"
  },
  "collections": {
    "clubs": {
      "name": "string",
      "publicDescription": "string",
      "settingsVersion": "integer",
      "contactName": "string(owner approved public contact)",
      "contactMethod": "phone|wechat|other",
      "contactValue": "string(public business contact)",
      "contactInstructions": "string",
      "revision": "integer"
    },
    "users": {
      "appId": "string(server)",
      "wxOpenId": "string(private)",
      "status": "active|disabled|deletion_requested|deleted",
      "consentVersions": "object"
    },
    "memberships": {
      "userId": "string",
      "nickname": "string",
      "avatarFileId": "optional string(server-assigned private storage object reference; never projected)",
      "rankingOptIn": "boolean",
      "rankingConsentVersion": "integer",
      "memberKind": "founder|regular; missing means regular",
      "memberKindVersion": "integer; missing means 0",
      "memberKindExpiresAt": "timestamp|null",
      "recommendationOptIn": "boolean; missing means false; independent of rankingOptIn",
      "recommendationConsentVersion": "integer",
      "recommendationPriority": "integer0..999(owner-only)",
      "kindRequestStatus": "pending|resolved|null",
      "kindRequestedAt": "timestamp|null",
      "kindRequestReason": "string(private)",
      "revision": "integer",
      "memberNumber": "optional nonnegative safe integer; 0 reserved for trusted initial owner bootstrap, new regular identities allocate >=1; private display field, no authority"
    },
    "staff_roles": {
      "userId": "string",
      "role": "owner|operator|leader|checkin",
      "activityIds": "string[]|null",
      "enabled": "boolean",
      "expiresAt": "timestamp|null",
      "grantedBy": "string"
    },
    "activities": {
      "title": "string",
      "state": "activity-state",
      "startAt": "timestamp",
      "endAt": "timestamp",
      "applicationClosesAt": "timestamp",
      "capacity": "integer>0",
      "reservedSeats": "integer>=0",
      "minGrowthPoints": "integer>=0",
      "requiredQualifications": "string[] of independently reviewed qualification types",
      "ruleVersion": "integer",
      "pointsRule": "object",
      "revision": "integer",
      "actualCompletedAt": "timestamp|null",
      "actualStartedAt": "timestamp(server)|null",
      "waitlistCount": "integer>=0"
    },
    "registrations": {
      "activityId": "string",
      "memberId": "string",
      "state": "registration-state",
      "seatState": "none|held|released",
      "reviewDecision": "pending|approved|rejected|not_required",
      "queueSeq": "integer",
      "attempt": "integer",
      "revision": "integer",
      "acceptedRuleVersion": "integer",
      "holdExpiresAt": "timestamp|null",
      "settlementId": "string|null",
      "memberKindAtApplication": "founder|regular",
      "memberKindVersionAtApplication": "integer",
      "memberKindAtConfirmation": "founder|regular|absent",
      "memberKindVersionAtConfirmation": "integer|absent",
      "confirmationPath": "founder_direct|staff_manual",
      "confirmedAt": "timestamp|absent",
      "confirmedBy": "system_founder|trusted staff userId|absent",
      "lastDepartureDay": "YYYY-MM-DD|absent",
      "lastReturnDay": "YYYY-MM-DD|absent",
      "completionVoided": "boolean|absent",
      "voidedAt": "timestamp|absent"
    },
    "qualifications": {
      "memberId": "string",
      "type": "string",
      "level": "string",
      "expiresAt": "timestamp|null",
      "decision": "pending|approved|rejected",
      "reviewedBy": "string|null",
      "reviewedAt": "timestamp|null",
      "revision": "integer; legacy missing means 0"
    },
    "checkins": {
      "activityId": "string",
      "memberId": "string",
      "phase": "departure|return",
      "day": "YYYY-MM-DD",
      "result": "present|safe_exit|no_show",
      "verifiedBy": "string",
      "verifiedAt": "timestamp"
    },
    "points_ledger": {
      "activityId": "string|null",
      "memberId": "string",
      "awardType": "completion|reversal|migration|correction",
      "businessKey": "string(unique deterministic)",
      "growthDelta": "integer",
      "annualDelta": "integer",
      "completedCountDelta": "integer",
      "year": "integer",
      "effectiveAt": "timestamp",
      "ruleVersion": "integer",
      "relatedEntryId": "string|null",
      "actorId": "string",
      "reason": "string"
    },
    "member_stats": {
      "memberId": "string",
      "scope": "growth|year",
      "year": "integer|null",
      "points": "integer",
      "completedCount": "integer>=0",
      "revision": "integer"
    },
    "public_rankings": {
      "memberPublicId": "string",
      "nickname": "string",
      "metric": "growth|annual|completed_count",
      "score": "integer",
      "year": "integer|null",
      "consentVersion": "integer"
    },
    "annual_rewards": {
      "year": "integer",
      "snapshotVersion": "integer",
      "status": "draft|frozen|issued|amended",
      "ruleVersion": "integer",
      "memberAwards": "object[]",
      "frozenAt": "timestamp|null"
    },
    "audit_logs": {
      "actorId": "string",
      "action": "string",
      "targetType": "string",
      "targetId": "string",
      "requestId": "string",
      "traceId": "string",
      "summary": "object(redacted)",
      "reason": "string|null"
    },
    "settlement_jobs": {
      "activityId": "string",
      "ruleVersion": "integer",
      "status": "pending|running|partial_failure|completed",
      "successCount": "integer",
      "failureCount": "integer",
      "cursor": "string|null",
      "errorSummary": "object|null"
    },
    "public_recommendations": {
      "memberId": "string(private lookup only)",
      "sortKey": "derived from effective member kind and manual priority",
      "visible": "boolean",
      "consentVersion": "integer(separate from ranking consent)"
    },
    "activity_briefings": {
      "activityId": "string(unique per club/activity)",
      "meetingPoint": "string(private)",
      "meetingTime": "timestamp|empty",
      "contactName": "string",
      "contactMethod": "phone|wechat|other",
      "contactValue": "string(private event contact)",
      "checklist": "string[]",
      "notes": "string(private)",
      "revision": "integer"
    }
  },
  "coreUniqueness": [
    "users:appId+wxOpenId",
    "memberships:clubId+userId",
    "registrations:clubId+activityId+memberId",
    "points_ledger:businessKey",
    "member_stats:clubId+memberId+scope+year",
    "activity_briefings:clubId+activityId",
    "public_recommendations:clubId+memberId",
    "clubs.member_number_claim:clubId+memberNumber via deterministic private claim document in the allocation transaction"
  ],
  "sensitiveCollections": [
    "users",
    "staff_roles",
    "registrations",
    "qualifications",
    "checkins",
    "points_ledger",
    "member_stats",
    "annual_rewards",
    "audit_logs",
    "settlement_jobs",
    "activity_briefings",
    "public_recommendations"
  ],
  "frontendDirectSensitiveWrite": false,
  "variants": {
    "member_stats.year_guard": {
      "kind": "year_guard",
      "year": "integer",
      "revision": "integer; updated atomically with each award/reversal; no scope"
    },
    "clubs.member_sequence": {
      "id": "key(member-sequence,clubId)",
      "kind": "member_sequence",
      "nextNumber": "safe integer>=1; next candidate; never lowered by product operations",
      "primaryOwnerMemberId": "private memberId|null; reservation only, not authorization"
    },
    "clubs.member_number_claim": {
      "id": "key(member-number,clubId,memberNumber)",
      "kind": "member_number_claim",
      "memberNumber": "nonnegative safe integer",
      "memberId": "private immutable membership reference; old positive claims retained after initial owner moves to zero"
    }
  },
  "privacyNotes": "All direct client DB access denied. Recommendation API projects only opted nickname/member kind; points/counts require separate rankingOptIn. Private briefing never appears in activity public projection. Avatar files are private and client storage access stays denied. Only the current member may request a short-lived avatar URL; public/member/staff projections omit avatar object IDs and URLs. Private memberNumber appears only in self and authorized staff responses. Public club projection excludes sequence/claim documents and public rankings/recommendations omit memberNumber."
}
