{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node",
      "miniprogram-api-typings"
    ],
    "lib": [
      "ES2020",
      "DOM"
    ],
    "noEmit": true
  },
  "include": [
    "shared/**/*.ts",
    "app/**/*.ts",
    "cloudfunctions/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "oradv-linux-handoff-v1.0.0"
  ]
}
